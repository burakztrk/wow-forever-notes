---
import '../styles/global.css';
import CodexIcon from '../components/CodexIcon.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { DEFAULT_LANG, LANGS, SITE_TITLE, type Lang } from '../config';
import { ui } from '../i18n';
import { OG_LOCALE, absoluteUrl, jsonLdString, ogImage } from '../lib/seo';
import { STORY_CLASSES } from '../lib/stories/classes';
import { STORY_RACES } from '../lib/stories/races';
import { storyUrl } from '../lib/stories/urls';
import { langHome, withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  lang: Lang;
  alternates: Record<Lang, string>;
  wide?: boolean; // wider main column (talent calculator)
  full?: boolean; // widest main column (home page race/class screen)
  ogType?: 'website' | 'article';
  publishedTime?: Date; // article:published_time for posts
  jsonLd?: object; // schema.org block (src/lib/seo.ts)
  noindex?: boolean;
  /** A story's hero image: preloaded and render-blocking, so the first frame (and a page transition) has it. */
  heroImage?: string;
}

const {
  title,
  description,
  lang,
  alternates,
  wide = false,
  full = false,
  ogType = 'website',
  publishedTime,
  jsonLd,
  noindex = false,
  heroImage,
} = Astro.props;
// which nav item is current: the first path segment after /<lang>/
const section = Astro.url.pathname.split(`/${lang}/`)[1]?.split('/')[0] ?? '';
const navItems = [
  { key: '', href: langHome(lang) },
  // the nav opens the first class and the first race story (their chip strips list the rest)
  { key: 'classes', href: storyUrl(lang, STORY_CLASSES[0].slug!) },
  { key: 'races', href: storyUrl(lang, STORY_RACES[0].slug!) },
  { key: 'notes', href: withBase(`/${lang}/notes/`) },
  { key: 'professions', href: withBase(`/${lang}/professions/`) },
  { key: 'legacy', href: withBase(`/${lang}/legacy/`) },
  { key: 'stories', href: withBase(`/${lang}/stories/`) },
  { key: 'search', href: withBase(`/${lang}/search/`) },
];
// Footer text stays English on every language page.
const DISCLAIMER =
  'Unofficial fan site. World of Warcraft and related names, icons and data are the property of Blizzard Entertainment.';
const t = ui(lang);
const labels: Record<string, string> = {
  '': t.navHome,
  notes: t.navNotes,
  races: t.navRaces,
  classes: t.navClasses,
  professions: t.navProfessions,
  legacy: t.navLegacy,
  stories: t.navStories,
  search: t.navSearch,
};
// /<lang>/stats/<id>/ is a class's or a race's (alliance-…, horde-…) stats page
const raceStats = /^(alliance|horde)-/.test(Astro.url.pathname.split(`/${lang}/stats/`)[1] ?? '');
const isCurrent = (key: string) =>
  key === ''
    ? section === ''
    : key === 'notes'
      ? section === 'notes' || section === 'blog'
      : key === 'classes'
        ? section === 'classes' || section === 'talents' || (section === 'stats' && !raceStats)
        : key === 'races'
          ? section === 'races' || (section === 'stats' && raceStats)
          : section === key;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const metaDescription = description ?? t.tagline;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const image = ogImage(lang, Astro.site);
// Cloudflare Web Analytics (cookie-free). The beacon token is public (it ends
// up in the page source); it comes from the CF_WEB_ANALYTICS_TOKEN repository
// variable at build time, and without it no script is added.
const cfBeacon = import.meta.env.PROD ? import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // The mobile app shows some pages (the stories) in a web view whose User-Agent carries
      // "ForeverCampfire/<version>". There the app draws its own bars: html.in-app hides the
      // site's header and footer (global.css), pinch zoom is off and the visit statistics
      // below are not loaded (the app's own statistics, with their off switch, cover it).
      if (/\bForeverCampfire\//.test(navigator.userAgent)) {
        document.documentElement.classList.add('in-app');
        document
          .querySelector('meta[name="viewport"]')
          ?.setAttribute('content', 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no');
      }
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" blocking="render" />}
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {LANGS.map((l) => (
            <link rel="alternate" hreflang={l} href={absoluteUrl(alternates[l], Astro.site)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates[DEFAULT_LANG], Astro.site)} />
        </>
      )
    }
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:alt" content={SITE_TITLE} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE_TITLE} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLdString(jsonLd)} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {
      cfBeacon && (
        <script is:inline data-beacon={JSON.stringify({ token: cfBeacon })}>
          // not inside the app (see the in-app script above)
          if (!document.documentElement.classList.contains('in-app')) {
            const beacon = document.createElement('script');
            beacon.defer = true;
            beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
            beacon.setAttribute('data-cf-beacon', document.currentScript.getAttribute('data-beacon'));
            document.head.appendChild(beacon);
          }
        </script>
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href={langHome(lang)}>Forever Campfire <span>Codex</span></a>
        <nav class="main-nav">
          {
            navItems.map((item) =>
              item.key === 'search' ? (
                <a
                  class="nav-icon"
                  href={item.href}
                  aria-current={isCurrent(item.key) ? 'page' : undefined}
                  aria-label={labels[item.key]}
                  title={labels[item.key]}
                >
                  <CodexIcon name="search" />
                </a>
              ) : (
                <a href={item.href} aria-current={isCurrent(item.key) ? 'page' : undefined}>
                  {labels[item.key]}
                </a>
              ),
            )
          }
        </nav>
        <LangSwitch lang={lang} alternates={alternates} />
      </div>
    </header>

    <main class:list={['container', 'site-main', { wide, full }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{DISCLAIMER}</p>
        <p>
          Game data:
          <a href="https://wowforever.wclbox.com/en" rel="noopener">wclbox</a>
          ·
          <a href="https://wowforevertools.com/" rel="noopener">WoW Forever Tools</a>
          ·
          <a href="https://us.forums.blizzard.com/en/wow/" rel="noopener">Blizzard Forums</a>
          ·
          <a href="https://classicwowforever.com/" rel="noopener">Classic WoW Forever</a> (CC BY 4.0)
        </p>
      </div>
    </footer>

    <slot name="after" />
    <script>
      import '../scripts/tooltip';
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(22, 25, 34, 0.95), rgba(14, 16, 21, 0.95));
    position: relative;
  }
  .site-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: 0.6;
  }
  .site-header .container {
    max-width: calc(1060px + 2 * var(--gutter));
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 60px;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .brand span {
    color: var(--text);
    font-weight: 500;
  }
  .header-row {
    flex-wrap: wrap;
  }
  .main-nav {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-right: auto;
    margin-left: 12px;
  }
  .main-nav a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .main-nav a:hover,
  .main-nav a[aria-current='page'] {
    color: var(--gold);
  }
  /* search: the app's scrying-lens icon instead of a word */
  .main-nav .nav-icon {
    display: inline-flex;
    align-items: center;
  }
  .main-nav .nav-icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  @media (max-width: 520px) {
    .main-nav {
      order: 3;
      width: 100%;
      margin: 0 0 10px;
      flex-wrap: wrap;
      gap: 4px 14px;
    }
  }
  .site-main.wide {
    max-width: calc(1060px + 2 * var(--gutter));
  }
  .site-main.full {
    max-width: calc(1400px + 2 * var(--gutter));
  }
  .site-main {
    flex: 1;
    padding-top: 28px;
    padding-bottom: 56px;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--text-mute);
    font-size: 0.8rem;
    padding: 18px 0 28px;
  }
  .site-footer p {
    margin: 0.3em 0;
  }
  .site-footer a {
    color: var(--text-dim);
  }
</style>
