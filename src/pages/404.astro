---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LANG, LANGS, type Lang } from '../config';
import { langHome, withBase } from '../utils/url';

const alternates = Object.fromEntries(LANGS.map((l) => [l, langHome(l)])) as Record<Lang, string>;
---

<BaseLayout title="404" lang={DEFAULT_LANG} noindex alternates={alternates}>
  <h1>404</h1>
  <p>Sayfa bulunamadı · Page not found</p>
  <p>
    <a href={withBase('/tr/notes/')}>Türkçe notlar</a> · <a href={withBase('/en/notes/')}>English notes</a>
  </p>
</BaseLayout>
<script is:inline>
  // Links from before the move to foreverwow.app carried a /wow-forever-notes
  // prefix; GitHub Pages cannot redirect them server-side, so forward visitors.
  var legacy = '/wow-forever-notes';
  if (location.pathname === legacy || location.pathname.indexOf(legacy + '/') === 0) {
    location.replace(location.pathname.slice(legacy.length) + location.search + location.hash || '/');
  }
</script>
