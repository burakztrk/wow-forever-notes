---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LANG, LANGS, type Lang } from '../config';
import { langHome } from '../utils/url';

const alternates = Object.fromEntries(LANGS.map((l) => [l, langHome(l)])) as Record<Lang, string>;
---

<BaseLayout title="404" lang={DEFAULT_LANG} alternates={alternates}>
  <h1>404</h1>
  <p>Sayfa bulunamadı · Page not found</p>
  <p>
    <a href={langHome('tr')}>Türkçe notlar</a> · <a href={langHome('en')}>English notes</a>
  </p>
</BaseLayout>
