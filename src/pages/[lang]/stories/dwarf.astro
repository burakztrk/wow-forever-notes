---
// Race story: Dwarf. Copy in src/i18n/stories.ts, drawings in
// src/lib/stories/dwarf-art.ts (generated by scripts/stories/dwarf_art.py), scroll
// effects in src/scripts/story.ts, styles in src/styles/stories.css (all scoped under .lore).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CurseLink from '../../../components/stories/CurseLink.astro';
import RaceChips from '../../../components/stories/RaceChips.astro';
import StoryEnd from '../../../components/stories/StoryEnd.astro';
import StoryHeader from '../../../components/stories/StoryHeader.astro';
import { LANGS, type Lang } from '../../../config';
import { ui } from '../../../i18n';
import { DWARF_ART_LABELS, DWARF_STORY, STORY_UI } from '../../../i18n/stories';
import { fillArt } from '../../../lib/stories/art';
import { DWARF_ART } from '../../../lib/stories/dwarf-art';
import { curseUrl, withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const s = DWARF_STORY[lang];
const u = STORY_UI[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/stories/dwarf/`)])) as Record<Lang, string>;
const base = withBase('/');
const art = (svg: string) => fillArt(svg, DWARF_ART_LABELS[lang], base);
const img = (name: string) => withBase(`/stories/dwarf/${name}`);
const ic = DWARF_ART.icons;

const chapters = [
  { id: 'origin', num: 'I', name: s.chapters.origin },
  { id: 'hammers', num: 'II', name: s.chapters.hammers },
  { id: 'fire', num: 'III', name: s.chapters.fire },
  { id: 'wars', num: 'IV', name: s.chapters.wars },
  { id: 'today', num: 'V', name: s.chapters.today },
];
const stageIcons = [
  // Titan
  '<circle cx="32" cy="32" r="22"/><path d="M32 14 47.6 41H16.4Z"/><circle cx="32" cy="32" r="3.5" fill="currentColor" stroke="none"/><path d="M32 4v6M32 54v6M4 32h6M54 32h6"/>',
  // earthen: a stone body with cracks
  '<path d="M22 8h20l5 11-4 11H21l-4-11Z"/><path d="M25 19h5M34 19h5"/><path d="M15 34h34l-5 24H20Z"/><path d="M29 8l-2 6 4 4M36 36l-3 8 4 5-2 7"/><path d="M15 34 8 46l5 3M49 34l7 12-5 3"/>',
  // Curse of Flesh: half stone, half flesh
  '<path d="M32 10 19 15l-5 15 5 15 13 9"/><path d="M32 10c10 0 18 8 18 21s-8 21-18 23"/><path d="M32 10l-3 8 4 6-4 7 4 7-3 8 2 8"/><path d="M20 28h6"/><circle cx="40" cy="28" r="2.2" fill="currentColor" stroke="none"/><path d="M37 41c2.5 2 5 2 7 0"/><circle cx="54" cy="16" r="1.6" fill="currentColor" stroke="none"/><circle cx="58" cy="23" r="1.1" fill="currentColor" stroke="none"/><circle cx="49" cy="10" r="1.1" fill="currentColor" stroke="none"/>',
  // dwarf: helm, eyes, braided beard
  '<path d="M16 28c0-10 7-16 16-16s16 6 16 16Z"/><path d="M13 28h38M32 28v7"/><path d="M16 23c-6-1-9-6-7-11 2 4 5 6 9 6M48 23c6-1 9-6 7-11-2 4-5 6-9 6"/><circle cx="25" cy="33" r="2" fill="currentColor" stroke="none"/><circle cx="39" cy="33" r="2" fill="currentColor" stroke="none"/><path d="M17 33c0 13 6 23 15 25 9-2 15-12 15-25"/><path d="M26 43l2 9M38 43l-2 9M32 45v11"/>',
];
const clanColor = ['var(--gold)', 'var(--wild)', 'var(--dark-iron)'];
const clanIcons = [ic.bronzebeard, ic.wildhammer, ic.darkiron];
const placeIcons = [ic.flame, ic.volcano, ic.steppe];
const warIcons = [ic.gate, ic.wing, ic.dragon, ic.sword];
const placeImages = [withBase('/maps/searing-gorge.webp'), img('blackrock.webp'), img('burning-steppes.webp')];
const delay = (i: number) => `--d:${(i * 0.08).toFixed(2)}s`;
---

<BaseLayout title={`Dwarf · ${t.storiesTitle}`} description={s.metaDescription} lang={lang} alternates={alternates} full>
  <div class="lore" id="lore">
    <StoryHeader lang={lang} chapters={chapters} icon={ic.brandCog} />

    <section class="hero forge" aria-labelledby="h-dwarf">
      <div class="hero-bg" aria-hidden="true"><img src={img('ironforge-forge.webp')} alt="" width="1920" height="864" /></div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="sil" aria-hidden="true"><img src={img('magni.webp')} alt="" width="447" height="447" /></div>
      <canvas id="snow" data-fx="embers" aria-hidden="true"></canvas>
      <div class="wrap hero-in">
        <div class="hero-col">
          <RaceChips lang={lang} current="dwarf" />
          <div class="hero-copy">
            <p class="ov">{s.overline} · <span lang="en">Alliance</span></p>
            <h1 class="h1" id="h-dwarf">Dwarf</h1>
            <p class="lead">{s.lead}</p>
            <a class="cue" href="#origin">{u.cue} <b aria-hidden="true">↓</b></a>
          </div>
        </div>
      </div>
    </section>

    <section class="facts" aria-label="Dwarf">
      <dl class="wrap">
        {
          s.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>
                {fact.value}
                {fact.extra && <span> · {fact.extra}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- I · origin -->
    <section class="chap chap-bg" id="origin" aria-labelledby="h-origin">
      <div class="chap-art" aria-hidden="true"><img src={img('earthen.webp')} alt="" width="340" height="426" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">I</div>
          <div>
            <p class="ov">{u.chapter} I · {s.chapters.origin}</p>
            <h2 class="h2" id="h-origin">{s.origin.title} <a lang="en" class="title-note" href={curseUrl(lang)}>{s.origin.titleNote}</a></h2>
          </div>
        </header>
        <div class="prose rv">{s.origin.paragraphs.map((p) => <p>{p}</p>)}</div>
        <div class="evo-wrap" id="evo" data-p=".95,.35">
          <ol class="evo" aria-label={s.origin.stagesLabel}>
            <li class="evo-line" aria-hidden="true"><i></i></li>
            {
              s.origin.stages.map((stage, i) => (
                <li class="stage rv" style={delay(i)}>
                  <div class="ico">
                    <svg viewBox="0 0 64 64" aria-hidden="true" set:html={stageIcons[i]} />
                  </div>
                  <div class="t">
                    <h3>{stage.name}</h3>
                    <p>{stage.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="mf" aria-hidden="true"><span>{s.origin.stone}</span><div class="mf-bar"><b></b></div><span>{s.origin.flesh}</span></div>
        </div>
        <CurseLink lang={lang} />
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p>{s.origin.note}</p></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sepCog} /></svg></div>

    <!-- II · the three hammers -->
    <section class="chap" id="hammers" aria-labelledby="h-hammers">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">II</div>
          <div><p class="ov">{u.chapter} II · {s.chapters.hammers}</p><h2 class="h2" id="h-hammers">{s.hammers.title}</h2></div>
        </header>
        <div class="split">
          <div class="prose rv">{[s.hammers.intro, ...s.hammers.more].map((p) => <p>{p}</p>)}</div>
          <figure class="hammers-fig" id="crest" data-p=".95,.35" data-moves>
            <Fragment set:html={art(DWARF_ART.crest)} />
            <figcaption>{s.hammers.crestCaption}</figcaption>
          </figure>
        </div>
        <div class="clans">
          {
            s.hammers.clans.map((clan, i) => (
              <article class="card clan rv" style={`--clan:${clanColor[i]};${delay(i)}`}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={clanIcons[i]} />
                </div>
                <h3 class="h3">{clan.name}</h3>
                <p class="who" lang="en">{clan.leader}</p>
                <p>{clan.text}</p>
              </article>
            ))
          }
        </div>
        <div class="story" id="story" data-step="1">
          <ol class="steps">
            {
              s.hammers.steps.map((step, i) => (
                <li class:list={['step', { active: i === 0 }]} data-era={step.era} data-title={step.title}>
                  <p class="ov" lang="en">{step.era}</p>
                  <h3 class="h3">{step.title}</h3>
                  <p>{step.text}</p>
                  <span class:list={['status', step.tone]}>
                    <i />
                    {step.status}
                  </span>
                </li>
              ))
            }
          </ol>
          <figure class="stage-map" aria-label={s.hammers.mapLabel}>
            <figcaption class="map-cap">
              <span class="t"
                ><span class="ov" id="capEra" lang="en">{s.hammers.steps[0].era}</span><span id="capTitle">{s.hammers.steps[0].title}</span></span
              >
              <span class="dots" aria-hidden="true">{s.hammers.steps.map((_, i) => <i class:list={{ on: i === 0 }} />)}</span>
            </figcaption>
            <Fragment set:html={art(DWARF_ART.ek)} />
          </figure>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p>{s.hammers.note}</p></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sepCog} /></svg></div>

    <!-- III · fire -->
    <section class="chap" id="fire" aria-labelledby="h-fire">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">III</div>
          <div><p class="ov">{u.chapter} III · {s.chapters.fire}</p><h2 class="h2" id="h-fire">{s.fire.title}</h2></div>
        </header>
        <div class="prose rv">{[s.fire.intro, ...s.fire.more].map((p) => <p>{p}</p>)}</div>
        <div class="scene solo">
          <div class="stat plain fire rv" style="--d:.1s">
            <p class="ov stat-ov">{s.fire.statLabel}</p>
            <p class="stat-n" aria-label={s.fire.statAria}><span class="count" data-to="230">230</span><span class="stat-u">{s.fire.statUnit}</span></p>
            <p set:html={s.fire.statText} />
            <p class="small">{s.fire.statDetail}</p>
          </div>
        </div>
        <div class="rag-bg">
          <div class="rag-art" aria-hidden="true"><img src={img('ragnaros.webp')} alt="" width="712" height="658" loading="lazy" /></div>
          <div class="sub sub-h rv"><p class="ov">{s.fire.ragnaros.label}</p><h3 class="h3">{s.fire.ragnaros.title}</h3></div>
          <div class="prose rv">{s.fire.ragnaros.paragraphs.map((p) => <p>{p}</p>)}</div>
        </div>
        <div class="trio">
          {
            s.fire.places.map((place, i) => (
              <article class="card rv" style={delay(i)}>
                <div class="place-img"><img src={placeImages[i]} alt={place.name} loading="lazy" /></div>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={placeIcons[i]} />
                </div>
                <p class="ov">{place.tag}</p>
                <h3 class="h3">{place.name}</h3>
                <p>{place.text}</p>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p>{s.fire.note}</p></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sepCog} /></svg></div>

    <!-- IV · wars -->
    <section class="chap" id="wars" aria-labelledby="h-wars">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">IV</div>
          <div><p class="ov">{u.chapter} IV · {s.chapters.wars}</p><h2 class="h2" id="h-wars">{s.wars.title}</h2></div>
        </header>
        <div class="prose rv">{[s.wars.intro, ...s.wars.more].map((p) => <p>{p}</p>)}</div>
        <figure class="map-fig rv" id="kz" data-p=".72,.22" data-routes>
          <Fragment set:html={art(DWARF_ART.kz)} />
          <figcaption>
            <span>{s.wars.mapCaption}</span>
            <span class="keys"
              ><span class="key horde"><i></i>{s.wars.hordeKey}</span><span class="key wild"><i></i>{s.wars.gryphonKey}</span></span
            >
          </figcaption>
          <ol class="legend">
            {
              s.wars.legend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    {item.text}
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
        <div class="war-cards">
          {
            s.wars.cards.map((card, i) => (
              <article class="card rv" style={delay(i % 2)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={warIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p>{card.text}</p>
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p>{s.wars.note}</p></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sepCog} /></svg></div>

    <!-- V · today -->
    <section class="chap chap-bg" id="today" aria-labelledby="h-today">
      <div class="chap-art full" aria-hidden="true"><img src={img('council-hall.webp')} alt="" width="1366" height="768" loading="lazy" /></div>
      <div class="sil sil-council" aria-hidden="true"><img src={img('magni-bust.webp')} alt="" width="300" height="300" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">V</div>
          <div><p class="ov">{u.chapter} V · {s.chapters.today}</p><h2 class="h2" id="h-today">{s.today.title}</h2></div>
        </header>
        <div class="prose rv">{s.today.intro.map((p) => <p>{p}</p>)}</div>
        <div class="sub rv"><p class="ov">{s.today.councilLabel}</p><p class="council-text">{s.today.councilText}</p></div>
        <div class="clans">
          {
            s.today.council.map((member, i) => (
              <article class="card clan member rv" style={`--clan:${clanColor[i]};${delay(i)}`}>
                {member.image ? (
                  <div class="portrait"><img src={img(member.image)} alt={member.name} width="300" height="300" loading="lazy" /></div>
                ) : (
                  <div class="ic">
                    <svg viewBox="0 0 48 48" aria-hidden="true" set:html={clanIcons[i]} />
                  </div>
                )}
                <p class="ov" lang="en">{member.leader}</p>
                <h3 class="h3">{member.name}</h3>
                <p>{member.text}</p>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <section class="chap tight" aria-labelledby="h-beyond">
      <div class="wrap">
        <div class="sub rv"><p class="ov">{s.today.beyondLabel}</p><h3 class="h3" id="h-beyond">{s.today.beyondTitle}</h3></div>
        <figure class="map-fig rv" id="world" data-p=".72,.22" data-routes>
          <Fragment set:html={art(DWARF_ART.world)} />
          <figcaption>
            <span>{s.today.mapCaption}</span>
            <span class="keys"><span class="key"><i></i>{s.today.routesKey}</span></span>
          </figcaption>
          <ol class="legend">
            {
              s.today.legend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    {item.text}
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
        <div class="prose rv">{s.today.beyondText.map((p) => <p>{p}</p>)}</div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p>{s.today.note}</p></aside>
      </div>
    </section>

    <StoryEnd lang={lang} title={s.outro.title} text={s.outro.text} next="Human" nextText={s.outro.nextText} images={s.images} />
  </div>
</BaseLayout>

<script>
  import '../../../scripts/story';
</script>
