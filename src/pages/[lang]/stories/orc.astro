---
// Race story: Orc. Copy in src/i18n/stories.ts, drawings in
// src/lib/stories/orc-art.ts (generated by scripts/stories/orc_art.py), scroll
// effects in src/scripts/story.ts, styles in src/styles/stories.css (all scoped under .lore).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RaceChips from '../../../components/stories/RaceChips.astro';
import StoryEnd from '../../../components/stories/StoryEnd.astro';
import StoryHeader from '../../../components/stories/StoryHeader.astro';
import StoryLinks from '../../../components/stories/StoryLinks.astro';
import { LANGS, type Lang } from '../../../config';
import { ui } from '../../../i18n';
import { ORC_ART_LABELS, ORC_STORY, STORY_UI } from '../../../i18n/stories';
import { fillArt } from '../../../lib/stories/art';
import { loreHtml, loreIds, loreTips } from '../../../lib/stories/lore';
import { ORC_ART } from '../../../lib/stories/orc-art';
import { islandJson } from '../../../lib/tooltip-payload';
import { withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const s = ORC_STORY[lang];
const u = STORY_UI[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/stories/orc/`)])) as Record<Lang, string>;
const art = (svg: string) => fillArt(svg, ORC_ART_LABELS[lang], withBase('/'));
const ic = ORC_ART.icons;
const img = (name: string) => withBase(`/stories/orc/${name}`);
// proper names in the text get lore tooltips (src/i18n/lore.ts); the cards ride in the #wf-glossary island
const lx = (text: string) => loreHtml(text);
const tips = loreTips(lang, loreIds(s));

const chapters = [
  { id: 'origin', num: 'I', name: s.chapters.origin },
  { id: 'portal', num: 'II', name: s.chapters.portal },
  { id: 'camps', num: 'III', name: s.chapters.camps },
  { id: 'exodus', num: 'IV', name: s.chapters.exodus },
  { id: 'today', num: 'V', name: s.chapters.today },
];
const stageIcons = [ic.totem, ic.horned, ic.felskull, ic.axes];
const portalIcons = [ic.fist, ic.hammer, ic.skull, ic.dragon];
const campIcons = [ic.keep, ic.letter, ic.axe, ic.helm];
const leaderIcons = [ic.bolt, ic.shield, ic.wolf];
const leaderColor = ['var(--horde)', 'var(--gold)', 'var(--frost)'];
const delay = (i: number) => `--d:${(i * 0.08).toFixed(2)}s`;
---

<BaseLayout title={`Orc · ${t.storiesTitle}`} description={s.metaDescription} lang={lang} alternates={alternates} full>
  <div class="lore orc" id="lore">
    <StoryHeader lang={lang} chapters={chapters} icon={ic.brand} />

    <section class="hero orc-gate" aria-labelledby="h-orc">
      <div class="hero-bg" aria-hidden="true"><img src={img('orgrimmar.webp')} alt="" width="739" height="415" /></div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="sil sil-thrall" aria-hidden="true"><img src={img('thrall.webp')} alt="" width="448" height="446" /></div>
      <canvas id="snow" data-fx="cinders" aria-hidden="true"></canvas>
      <div class="wrap hero-in">
        <div class="hero-col">
          <RaceChips lang={lang} current="orc" />
          <div class="hero-copy">
            <p class="ov">{s.overline} · <span lang="en">Horde</span></p>
            <h1 class="h1" id="h-orc" lang="en">Orc</h1>
            <p class="lead">{s.lead}</p>
            <a class="cue" href="#origin">{u.cue} <b aria-hidden="true">↓</b></a>
          </div>
        </div>
      </div>
      <StoryLinks lang={lang} kind="race" slug="orc" />
    </section>

    <section class="facts" aria-label="Orc">
      <dl class="wrap">
        {
          s.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>
                <Fragment set:html={lx(fact.value)} />
                {fact.extra && (
                  <span>
                    {' · '}
                    <Fragment set:html={lx(fact.extra)} />
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- I · origin -->
    <section class="chap chap-bg" id="origin" aria-labelledby="h-origin">
      <div class="chap-art top" aria-hidden="true"><img src={img('nerzhul.webp')} alt="" width="1000" height="500" loading="lazy" /></div>
      <div class="chap-art tall" aria-hidden="true"><img src={img('guldan.webp')} alt="" width="760" height="1040" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">I</div>
          <div>
            <p class="ov">{u.chapter} I · {s.chapters.origin}</p>
            <h2 class="h2" id="h-origin">{s.origin.title} <span lang="en" class="title-note">{s.origin.titleNote}</span></h2>
          </div>
        </header>
        <div class="prose rv">{s.origin.paragraphs.map((p) => <p set:html={lx(p)} />)}</div>
        <div class="evo-wrap" id="evo" data-p=".95,.35">
          <ol class="evo" aria-label={s.origin.stagesLabel}>
            <li class="evo-line" aria-hidden="true"><i></i></li>
            {
              s.origin.stages.map((stage, i) => (
                <li class="stage rv" style={delay(i)}>
                  <div class="ico">
                    <svg viewBox="0 0 64 64" aria-hidden="true" set:html={stageIcons[i]} />
                  </div>
                  <div class="t">
                    <h3>{stage.name}</h3>
                    <p>{stage.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="mf" aria-hidden="true"><span>{s.origin.before}</span><div class="mf-bar"><b></b></div><span>{s.origin.after}</span></div>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.origin.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- II · the Dark Portal and the two wars -->
    <section class="chap chap-bg" id="portal" aria-labelledby="h-portal">
      <div class="chap-art top pano" aria-hidden="true"><img src={img('dark-portal.webp')} alt="" width="379" height="180" loading="lazy" /></div>
      <div class="sil sil-guldan" aria-hidden="true"><img src={img('guldan-model.webp')} alt="" width="478" height="641" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">II</div>
          <div><p class="ov">{u.chapter} II · {s.chapters.portal}</p><h2 class="h2" id="h-portal">{s.portal.title}</h2></div>
        </header>
        <div class="split top">
          <div class="prose rv">{[s.portal.intro, ...s.portal.more].map((p) => <p set:html={lx(p)} />)}</div>
          <figure class="map-fig rv" id="warpath" data-p=".8,.15" data-routes>
            <Fragment set:html={art(ORC_ART.portal)} />
            <figcaption>
              <span>{s.portal.figureCaption}</span>
              <span class="keys">
                <span class="key horde"><i></i>{s.portal.hordeKey}</span>
                <span class="key void"><i></i>{s.portal.guldanKey}</span>
                <span class="key al"><i></i>{s.portal.allianceKey}</span>
              </span>
            </figcaption>
            <ol class="legend" style="--cols:1">
              {
                s.portal.legend.map((item, i) => (
                  <li>
                    <span class="lk">{i + 1}</span>
                    <span>
                      <b>{item.name}</b>
                      <Fragment set:html={lx(item.text)} />
                    </span>
                  </li>
                ))
              }
            </ol>
          </figure>
        </div>
        <div class="war-cards">
          {
            s.portal.cards.map((card, i) => (
              <article class="card rv" style={delay(i % 2)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={portalIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p set:html={lx(card.text)} />
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.portal.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- III · the internment camps -->
    <section class="chap chap-bg" id="camps" aria-labelledby="h-camps">
      <div class="chap-art top pano dim" aria-hidden="true"><img src={img('dark-portal.webp')} alt="" width="379" height="180" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">III</div>
          <div><p class="ov">{u.chapter} III · {s.chapters.camps}</p><h2 class="h2" id="h-camps">{s.camps.title}</h2></div>
        </header>
        <div class="prose rv">{[s.camps.intro, ...s.camps.more].map((p) => <p set:html={lx(p)} />)}</div>
        <div class="war-cards">
          {
            s.camps.cards.map((card, i) => (
              <article class="card rv" style={delay(i % 2)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={campIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p set:html={lx(card.text)} />
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.camps.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- IV · the exodus to Kalimdor -->
    <section class="chap" id="exodus" aria-labelledby="h-exodus">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">IV</div>
          <div><p class="ov">{u.chapter} IV · {s.chapters.exodus}</p><h2 class="h2" id="h-exodus">{s.exodus.title}</h2></div>
        </header>
        <div class="prose rv"><p set:html={lx(s.exodus.intro)} /></div>
        <div class="story" id="story" data-step="1">
          <ol class="steps">
            {
              s.exodus.steps.map((step, i) => (
                <li class:list={['step', { active: i === 0 }]} data-era={step.era} data-title={step.title}>
                  <p class="ov" lang="en">{step.era}</p>
                  <h3 class="h3">{step.title}</h3>
                  <p set:html={lx(step.text)} />
                  <span class:list={['status', step.tone]}>
                    <i />
                    {step.status}
                  </span>
                </li>
              ))
            }
          </ol>
          <figure class="stage-map" aria-label={s.exodus.mapLabel}>
            <figcaption class="map-cap">
              <span class="t"
                ><span class="ov" id="capEra" lang="en">{s.exodus.steps[0].era}</span><span id="capTitle">{s.exodus.steps[0].title}</span></span
              >
              <span class="dots" aria-hidden="true">{s.exodus.steps.map((_, i) => <i class:list={{ on: i === 0 }} />)}</span>
            </figcaption>
            <Fragment set:html={art(ORC_ART.ek)} />
          </figure>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.exodus.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- V · today -->
    <section class="chap" id="today" aria-labelledby="h-today">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">V</div>
          <div><p class="ov">{u.chapter} V · {s.chapters.today}</p><h2 class="h2" id="h-today">{s.today.title}</h2></div>
        </header>
        <div class="prose rv">{s.today.intro.map((p) => <p set:html={lx(p)} />)}</div>
        <div class="sub rv"><p class="ov">{s.today.leadersLabel}</p><p class="council-text">{s.today.leadersText}</p></div>
        <div class="clans">
          {
            s.today.leaders.map((leader, i) => (
              <article class="card clan rv" style={`--clan:${leaderColor[i]};${delay(i)}`}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={leaderIcons[i]} />
                </div>
                <p class="ov">{leader.role}</p>
                <h3 class="h3">{leader.name}</h3>
                <p set:html={lx(leader.text)} />
              </article>
            ))
          }
        </div>

        <div class="sub rv"><p class="ov">{s.today.landLabel}</p><h3 class="h3">{s.today.landTitle}</h3></div>
        <div class="split top">
          <div class="prose rv">{s.today.landText.map((p) => <p set:html={lx(p)} />)}</div>
          <figure class="map-fig rv" id="durotar" data-p=".72,.22" data-routes>
            <Fragment set:html={art(ORC_ART.durotar)} />
            <figcaption>
              <span>{s.today.landCaption}</span>
              <span class="keys"><span class="key"><i></i>{s.today.pathKey}</span></span>
            </figcaption>
            <ol class="legend" style="--cols:2">
              {
                s.today.landLegend.map((item, i) => (
                  <li>
                    <span class="lk">{i + 1}</span>
                    <span>
                      <b>{item.name}</b>
                      <Fragment set:html={lx(item.text)} />
                    </span>
                  </li>
                ))
              }
            </ol>
          </figure>
        </div>
      </div>
    </section>

    <section class="chap tight" aria-labelledby="h-beyond">
      <div class="wrap">
        <div class="sub rv"><p class="ov">{s.today.beyondLabel}</p><h3 class="h3" id="h-beyond">{s.today.beyondTitle}</h3></div>
        <div class="prose rv">{s.today.beyondText.map((p) => <p set:html={lx(p)} />)}</div>
        <figure class="map-fig rv" id="world" data-p=".72,.22" data-routes>
          <Fragment set:html={art(ORC_ART.world)} />
          <figcaption>
            <span>{s.today.mapCaption}</span>
            <span class="keys"><span class="key"><i></i>{s.today.routesKey}</span></span>
          </figcaption>
          <ol class="legend">
            {
              s.today.legend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    <Fragment set:html={lx(item.text)} />
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.today.note)} /></aside>
      </div>
    </section>

    <StoryEnd lang={lang} title={s.outro.title} text={s.outro.text} next="Troll" nextText={s.outro.nextText} images={s.images} />
  </div>
  <script slot="after" type="application/json" id="wf-glossary" is:inline set:html={islandJson(tips)} />
</BaseLayout>

<script>
  import '../../../scripts/story';
</script>
