---
// Race story: Skyborne (one people, two sides: the High Order and the Windshapers). Copy in
// src/i18n/stories.ts, drawings in src/lib/stories/skyborne-art.ts (generated by
// scripts/stories/skyborne_art.py), scroll effects in src/scripts/story.ts, styles in
// src/styles/stories.css (all scoped under .lore). The racials are the glossary's, shown as rows.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlossaryRow from '../../../components/GlossaryRow.astro';
import RaceChips from '../../../components/stories/RaceChips.astro';
import StoryEnd from '../../../components/stories/StoryEnd.astro';
import StoryHeader from '../../../components/stories/StoryHeader.astro';
import { LANGS, type Lang } from '../../../config';
import { ui } from '../../../i18n';
import { SKYBORNE_ART_LABELS, SKYBORNE_STORY, STORY_UI } from '../../../i18n/stories';
import { classesOf, races, racialsOf } from '../../../lib/codex';
import { fillArt } from '../../../lib/stories/art';
import { loreHtml, loreIds, loreTips } from '../../../lib/stories/lore';
import { SKYBORNE_ART } from '../../../lib/stories/skyborne-art';
import { islandJson } from '../../../lib/tooltip-payload';
import { withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const s = SKYBORNE_STORY[lang];
const u = STORY_UI[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/stories/skyborne/`)])) as Record<Lang, string>;
const art = (svg: string) => fillArt(svg, SKYBORNE_ART_LABELS[lang], withBase('/'));
const ic = SKYBORNE_ART.icons;
const icon = (name?: string) => (name ? withBase(`/icons/${name}.jpg`) : undefined);
// proper names in the text get lore tooltips (src/i18n/lore.ts); the cards ride in the #wf-glossary island
const lx = (text: string) => loreHtml(text);

// the two Skyborne races: racials and classes come from the synced data
const sideRaces = [
  { race: races.find((r) => r.id === 'alliance-skyborne-high-order')!, color: 'var(--alliance)' },
  { race: races.find((r) => r.id === 'horde-skyborne-windshaper')!, color: 'var(--horde)' },
];
const sharedIds = new Set(
  racialsOf(sideRaces[0].race)
    .filter((e) => racialsOf(sideRaces[1].race).some((o) => o.id === e.id))
    .map((e) => e.id),
);
const shared = racialsOf(sideRaces[0].race).filter((e) => sharedIds.has(e.id));
const glossaryIds = [...new Set(sideRaces.flatMap(({ race }) => racialsOf(race).map((e) => e.id)))];
const tips = loreTips(lang, loreIds(s), glossaryIds);

const chapters = [
  { id: 'origin', num: 'I', name: s.chapters.origin },
  { id: 'skywall', num: 'II', name: s.chapters.skywall },
  { id: 'paths', num: 'III', name: s.chapters.paths },
  { id: 'crisis', num: 'IV', name: s.chapters.crisis },
  { id: 'descent', num: 'V', name: s.chapters.descent },
];
const stageIcons = [ic.tower, ic.book, ic.mask, ic.wind];
const skywallIcons = [ic.spirit, ic.plane, ic.cyclone, ic.isle];
const bossIcons = [ic.crown, ic.flame];
const delay = (i: number) => `--d:${(i * 0.08).toFixed(2)}s`;
---

<BaseLayout title={`Skyborne · ${t.storiesTitle}`} description={s.metaDescription} lang={lang} alternates={alternates} full>
  <div class="lore skyborne" id="lore">
    <StoryHeader lang={lang} chapters={chapters} icon={ic.brand} />

    <section class="hero sky-cover" aria-labelledby="h-skyborne">
      <div class="hero-bg" aria-hidden="true"></div>
      <canvas id="snow" data-fx="gale" aria-hidden="true"></canvas>
      <div class="wrap hero-in">
        <div class="hero-col">
          <RaceChips lang={lang} current="skyborne" />
          <div class="hero-copy">
            <p class="ov">{s.overline} · <span lang="en">Alliance · Horde</span></p>
            <h1 class="h1" id="h-skyborne" lang="en">Skyborne</h1>
            <p class="lead">{s.lead}</p>
            <a class="cue" href="#origin">{u.cue} <b aria-hidden="true">↓</b></a>
          </div>
        </div>
      </div>
    </section>

    <section class="facts" aria-label="Skyborne">
      <dl class="wrap">
        {
          s.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>
                <Fragment set:html={lx(fact.value)} />
                {fact.extra && (
                  <span>
                    {' · '}
                    <Fragment set:html={lx(fact.extra)} />
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- I · origin: Eldre'Thalas -->
    <section class="chap" id="origin" aria-labelledby="h-origin">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">I</div>
          <div>
            <p class="ov">{u.chapter} I · {s.chapters.origin}</p>
            <h2 class="h2" id="h-origin">{s.origin.title} <span lang="en" class="title-note">{s.origin.titleNote}</span></h2>
          </div>
        </header>
        <div class="prose rv">{s.origin.paragraphs.map((p) => <p set:html={lx(p)} />)}</div>
        <figure class="map-fig rv" id="feralasmap" data-p=".8,.15" data-routes>
          <Fragment set:html={art(SKYBORNE_ART.feralas)} />
          <figcaption>
            <span>{s.origin.figureCaption}</span>
            <span class="keys">
              <span class="key"><i></i>{s.origin.escapeKey}</span>
            </span>
          </figcaption>
          <ol class="legend" style="--cols:2">
            {
              s.origin.legend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    <Fragment set:html={lx(item.text)} />
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
        <div class="evo-wrap" id="evo" data-p=".95,.35">
          <ol class="evo" aria-label={s.origin.stagesLabel}>
            <li class="evo-line" aria-hidden="true"><i></i></li>
            {
              s.origin.stages.map((stage, i) => (
                <li class="stage rv" style={delay(i)}>
                  <div class="ico">
                    <svg viewBox="0 0 64 64" aria-hidden="true" set:html={stageIcons[i]} />
                  </div>
                  <div class="t">
                    <h3>{stage.name}</h3>
                    <p>{stage.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="mf" aria-hidden="true"><span>{s.origin.before}</span><div class="mf-bar"><b></b></div><span>{s.origin.after}</span></div>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.origin.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- II · Skywall -->
    <section class="chap" id="skywall" aria-labelledby="h-skywall">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">II</div>
          <div><p class="ov">{u.chapter} II · {s.chapters.skywall}</p><h2 class="h2" id="h-skywall">{s.skywall.title}</h2></div>
        </header>
        <div class="prose rv">{[s.skywall.intro, ...s.skywall.more].map((p) => <p set:html={lx(p)} />)}</div>
        <figure class="map-fig rv" id="rise" data-p=".85,.25" data-moves>
          <Fragment set:html={art(SKYBORNE_ART.rise)} />
          <figcaption>{s.skywall.figureCaption}</figcaption>
        </figure>
        <div class="war-cards">
          {
            s.skywall.cards.map((card, i) => (
              <article class="card rv" style={delay(i % 2)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={skywallIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p set:html={lx(card.text)} />
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.skywall.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- III · two paths: the High Order and the Windshapers -->
    <section class="chap" id="paths" aria-labelledby="h-paths">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">III</div>
          <div><p class="ov">{u.chapter} III · {s.chapters.paths}</p><h2 class="h2" id="h-paths">{s.paths.title}</h2></div>
        </header>
        <div class="prose rv">{s.paths.intro.map((p) => <p set:html={lx(p)} />)}</div>
        <div class="sides">
          {
            s.paths.sides.map((side, i) => {
              const { race, color } = sideRaces[i];
              return (
                <article class="card side rv" style={`--side:${color};${delay(i)}`}>
                  <p class="ov">{side.faction}</p>
                  <h3 class="h3">
                    <Fragment set:html={lx(side.name)} />
                  </h3>
                  <p set:html={lx(side.text)} />
                  <dl class="side-facts">
                    {
                      side.facts.map((fact) => (
                        <div>
                          <dt>{fact.label}</dt>
                          <dd set:html={lx(fact.value)} />
                        </div>
                      ))
                    }
                  </dl>
                  <p class="ov side-h">{s.paths.racialLabel}</p>
                  <ul class="codex-list">
                    {racialsOf(race).filter((e) => !sharedIds.has(e.id)).map((entry) => <GlossaryRow entry={entry} lang={lang} />)}
                  </ul>
                  <p class="ov side-h">{s.paths.classesLabel}</p>
                  <ul class="classes">
                    {
                      classesOf(race).map((c) => (
                        <li>
                          <img src={icon(c.icon)} alt="" width="22" height="22" loading="lazy" />
                          {c.name}
                        </li>
                      ))
                    }
                  </ul>
                </article>
              );
            })
          }
        </div>

        <div class="sub rv"><p class="ov">{s.paths.sharedLabel}</p><h3 class="h3">{s.paths.sharedTitle}</h3></div>
        <div class="prose rv"><p set:html={lx(s.paths.sharedText)} /></div>
        <ul class="codex-list shared rv">
          {shared.map((entry) => <GlossaryRow entry={entry} lang={lang} />)}
        </ul>

        <div class="sub rv"><p class="ov">{s.paths.rivalryLabel}</p><h3 class="h3">{s.paths.rivalryTitle}</h3></div>
        <div class="prose rv">{s.paths.rivalryText.map((p) => <p set:html={lx(p)} />)}</div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.paths.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- IV · the crisis on Zephras Isle -->
    <section class="chap" id="crisis" aria-labelledby="h-crisis">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">IV</div>
          <div><p class="ov">{u.chapter} IV · {s.chapters.crisis}</p><h2 class="h2" id="h-crisis">{s.crisis.title}</h2></div>
        </header>
        <div class="prose rv"><p set:html={lx(s.crisis.intro)} /></div>
        <div class="story" id="story" data-step="1">
          <ol class="steps">
            {
              s.crisis.steps.map((step, i) => (
                <li class:list={['step', { active: i === 0 }]} data-era={step.era} data-title={step.title}>
                  <p class="ov" lang="en">{step.era}</p>
                  <h3 class="h3">{step.title}</h3>
                  <p set:html={lx(step.text)} />
                  <span class:list={['status', step.tone]}>
                    <i />
                    {step.status}
                  </span>
                </li>
              ))
            }
          </ol>
          <figure class="stage-map" aria-label={s.crisis.mapLabel}>
            <figcaption class="map-cap">
              <span class="t"
                ><span class="ov" id="capEra" lang="en">{s.crisis.steps[0].era}</span><span id="capTitle">{s.crisis.steps[0].title}</span></span
              >
              <span class="dots" aria-hidden="true">{s.crisis.steps.map((_, i) => <i class:list={{ on: i === 0 }} />)}</span>
            </figcaption>
            <Fragment set:html={art(SKYBORNE_ART.ek)} />
          </figure>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.crisis.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- V · the descent to Azeroth -->
    <section class="chap" id="descent" aria-labelledby="h-descent">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">V</div>
          <div><p class="ov">{u.chapter} V · {s.chapters.descent}</p><h2 class="h2" id="h-descent">{s.descent.title}</h2></div>
        </header>
        <div class="split top">
          <div class="col">
            <div class="prose rv">{s.descent.intro.map((p) => <p set:html={lx(p)} />)}</div>
            <ol class="legend plain rv" style="--cols:1">
              {
                s.descent.legend.map((item, i) => (
                  <li>
                    <span class="lk">{i + 1}</span>
                    <span>
                      <b>{item.name}</b>
                      <Fragment set:html={lx(item.text)} />
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
          <figure class="map-fig rv" id="zephras">
            <Fragment set:html={art(SKYBORNE_ART.zephras)} />
            <figcaption><span>{s.descent.mapCaption}</span></figcaption>
          </figure>
        </div>

        <div class="sub rv"><p class="ov">{s.descent.shipLabel}</p><h3 class="h3">{s.descent.shipTitle}</h3></div>
        <div class="prose rv">{s.descent.shipText.map((p) => <p set:html={lx(p)} />)}</div>
        <figure class="map-fig rv" id="world" data-p=".8,.15" data-routes>
          <Fragment set:html={art(SKYBORNE_ART.world)} />
          <figcaption>
            <span>{s.descent.worldCaption}</span>
            <span class="keys">
              <span class="key al"><i></i>{s.descent.allianceKey}</span>
              <span class="key horde"><i></i>{s.descent.hordeKey}</span>
            </span>
          </figcaption>
          <ol class="legend" style="--cols:4">
            {
              s.descent.worldLegend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    <Fragment set:html={lx(item.text)} />
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>

        <div class="sub rv"><p class="ov">{s.descent.direLabel}</p><h3 class="h3">{s.descent.direTitle}</h3></div>
        <div class="prose rv"><p set:html={lx(s.descent.direText)} /></div>
        <div class="war-cards">
          {
            s.descent.bosses.map((card, i) => (
              <article class="card rv" style={delay(i)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={bossIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p set:html={lx(card.text)} />
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.descent.note)} /></aside>
      </div>
    </section>

    <StoryEnd lang={lang} title={s.outro.title} text={s.outro.text} next="Tauren" nextText={s.outro.nextText} images={s.images} />
  </div>
  <script slot="after" type="application/json" id="wf-glossary" is:inline set:html={islandJson(tips)} />
</BaseLayout>

<script>
  import '../../../scripts/story';
</script>
