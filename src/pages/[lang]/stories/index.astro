---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGS, type Lang } from '../../../config';
import { ui } from '../../../i18n';
import { TIMELINE_UI } from '../../../i18n/timeline';
import StoryCarousel from '../../../components/stories/StoryCarousel.astro';
import { classSlides, FACTION_ORDER, pickSlides, raceSlides } from '../../../lib/stories/slides';
import { withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/stories/`)])) as Record<Lang, string>;
const tl = TIMELINE_UI[lang];
const slides = raceSlides(lang);
const factions = (['alliance', 'horde'] as const).map((key) => ({
  key,
  name: key === 'alliance' ? 'Alliance' : 'Horde',
  list: pickSlides(slides, FACTION_ORDER[key]),
}));
---

<BaseLayout title={t.storiesTitle} description={t.storiesIntro} lang={lang} alternates={alternates} wide>
  <div class="story-index">
    <h1>{t.storiesTitle}</h1>
    <p class="muted">{t.storiesIntro}</p>

    <a class="story-feature story-feature--timeline" href={withBase(`/${lang}/stories/timeline/`)}>
      <img class="story-feature-bg" src={withBase('/maps/azeroth.webp')} alt="" width="1002" height="668" loading="lazy" />
      <span class="story-feature-text">
        <span class="story-feature-over">{tl.cardOver}</span>
        <span class="story-feature-name">{tl.title}</span>
        <span class="story-feature-lead">{tl.cardLead}</span>
        <span class="story-feature-cta">{tl.cardCta}</span>
      </span>
    </a>

    <div class="story-factions">
      {
        factions.map(({ key, name, list }) => (
          <section class="story-faction">
            <h2 class:list={['codex-section', `faction-title--${key}`]}>{name}</h2>
            <StoryCarousel lang={lang} slides={list} label={name} />
          </section>
        ))
      }
    </div>

    <section>
      <h2 class="codex-section">{lang === 'tr' ? 'Sınıflar' : 'Classes'}</h2>
      <StoryCarousel lang={lang} slides={classSlides(lang)} label={lang === 'tr' ? 'Sınıflar' : 'Classes'} />
    </section>
  </div>
</BaseLayout>
