---
// Lore page: the Curse of Flesh. Shorter than a race story and with a single map. It is not
// listed on the story index, the race strip or the nav: the origin chapters of the stories that
// mention the curse link here (CurseLink.astro). Copy in src/i18n/stories.ts, drawings in
// src/lib/stories/curse-art.ts (generated by scripts/stories/curse_art.py).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StoryEnd from '../../../components/stories/StoryEnd.astro';
import StoryHeader from '../../../components/stories/StoryHeader.astro';
import { LANGS, type Lang } from '../../../config';
import { ui } from '../../../i18n';
import { CURSE_ART_LABELS, CURSE_STORY, DWARF_STORY, GNOME_STORY, HUMAN_STORY, STORY_UI } from '../../../i18n/stories';
import { fillArt } from '../../../lib/stories/art';
import { CURSE_ART } from '../../../lib/stories/curse-art';
import { STORY_RACES } from '../../../lib/stories/races';
import { curseUrl, withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const s = CURSE_STORY[lang];
const u = STORY_UI[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, curseUrl(l)])) as Record<Lang, string>;
const art = (svg: string) => fillArt(svg, CURSE_ART_LABELS[lang], withBase('/'));
const ic: Record<string, string> = CURSE_ART.icons;
const icon = (name: string) => ic[name.toLowerCase()];

const chapters = [
  { id: 'curse', num: 'I', name: s.chapters.curse },
  { id: 'peoples', num: 'II', name: s.chapters.peoples },
  { id: 'meaning', num: 'III', name: s.chapters.meaning },
];
const stageIcons = [ic.titan, ic.forged, ic.curse, ic.peoples];
// the written stories the curse touched, in the race strip's order
const overlines: Record<string, string> = { gnome: GNOME_STORY[lang].overline, dwarf: DWARF_STORY[lang].overline, human: HUMAN_STORY[lang].overline };
const stories = STORY_RACES.filter((r) => r.slug && r.slug in overlines);
const delay = (i: number) => `--d:${(i * 0.08).toFixed(2)}s`;
---

<BaseLayout title={`Curse of Flesh · ${t.storiesTitle}`} description={s.metaDescription} lang={lang} alternates={alternates} full>
  <div class="lore" id="lore">
    <StoryHeader lang={lang} chapters={chapters} icon={ic.brand} />

    <section class="hero curse" aria-labelledby="h-curse">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="emblem-wrap" aria-hidden="true" set:html={CURSE_ART.emblem} />
      <canvas id="snow" data-fx="void" aria-hidden="true"></canvas>
      <div class="wrap hero-in">
        <div class="hero-col">
          <div class="hero-copy">
            <p class="ov">{s.overline}</p>
            <h1 class="h1" id="h-curse" lang="en">Curse of Flesh</h1>
            <p class="lead">{s.lead}</p>
            <a class="cue" href="#curse">{u.cue} <b aria-hidden="true">↓</b></a>
          </div>
        </div>
      </div>
    </section>

    <section class="facts" aria-label="Curse of Flesh">
      <dl class="wrap">
        {
          s.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>
                {fact.value}
                {fact.extra && <span> · {fact.extra}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- I · the curse -->
    <section class="chap" id="curse" aria-labelledby="h-curse-1">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">I</div>
          <div><p class="ov">{u.chapter} I · {s.chapters.curse}</p><h2 class="h2" id="h-curse-1">{s.curse.title}</h2></div>
        </header>
        <div class="prose rv">{s.curse.paragraphs.map((p) => <p>{p}</p>)}</div>
        <div class="evo-wrap" id="evo" data-p=".95,.35">
          <ol class="evo" aria-label={s.curse.stagesLabel}>
            <li class="evo-line" aria-hidden="true"><i></i></li>
            {
              s.curse.stages.map((stage, i) => (
                <li class="stage rv" style={delay(i)}>
                  <div class="ico">
                    <svg viewBox="0 0 64 64" aria-hidden="true" set:html={stageIcons[i]} />
                  </div>
                  <div class="t">
                    <h3>{stage.name}</h3>
                    <p>{stage.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="mf" aria-hidden="true"><span>{s.curse.before}</span><div class="mf-bar"><b></b></div><span>{s.curse.after}</span></div>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p>{s.curse.note}</p></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- II · the peoples it touched -->
    <section class="chap" id="peoples" aria-labelledby="h-peoples">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">II</div>
          <div><p class="ov">{u.chapter} II · {s.chapters.peoples}</p><h2 class="h2" id="h-peoples">{s.peoples.title}</h2></div>
        </header>
        <div class="prose rv"><p>{s.peoples.intro}</p></div>
        <div class="morphs">
          {
            s.peoples.changes.map((c, i) => (
              <article class="card morph rv" style={delay(i)}>
                <div class="morph-ic" aria-hidden="true">
                  <span class="ic">
                    <svg viewBox="0 0 64 64" set:html={icon(c.from)} />
                  </span>
                  <b>→</b>
                  <span class="ic to">
                    <svg viewBox="0 0 64 64" set:html={icon(c.to)} />
                  </span>
                </div>
                <p class="ov" lang="en">
                  {c.from} → {c.to}
                </p>
                <p>{c.text}</p>
                {c.slug && (
                  <a class="go" href={withBase(`/${lang}/stories/${c.slug}/`)}>
                    {u.read} <b aria-hidden="true">→</b>
                  </a>
                )}
              </article>
            ))
          }
        </div>
        <figure class="map-fig rv" id="world" data-p=".72,.22" data-routes>
          <Fragment set:html={art(CURSE_ART.world)} />
          <figcaption>
            <span>{s.peoples.mapCaption}</span>
            <span class="keys"><span class="key"><i></i>{s.peoples.routesKey}</span><span class="key dot"><i></i>{s.peoples.prisonKey}</span></span>
          </figcaption>
          <ol class="legend">
            {
              s.peoples.legend.map((item, i) => (
                <li>
                  <span class:list={['lk', { o: i < 3 }]}>{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    {item.text}
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p>{s.peoples.note}</p></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- III · curse or gift -->
    <section class="chap" id="meaning" aria-labelledby="h-meaning">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">III</div>
          <div><p class="ov">{u.chapter} III · {s.chapters.meaning}</p><h2 class="h2" id="h-meaning">{s.meaning.title}</h2></div>
        </header>
        <div class="prose rv">{s.meaning.paragraphs.map((p) => <p>{p}</p>)}</div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p>{s.meaning.note}</p></aside>
      </div>
    </section>

    <StoryEnd lang={lang} title={s.outro.title} text={s.outro.text} images={s.images}>
      <nav class="next-list rv" style="--d:.1s" aria-label={s.outro.storiesLabel}>
        {
          stories.map((race) => (
            <a class="next live mini" href={withBase(`/${lang}/stories/${race.slug}/`)}>
              <span class="ov next-ov">{overlines[race.slug!]}</span>
              <span class="nm" lang="en">
                {race.name}
              </span>
              <span class="go">
                {u.read} <b aria-hidden="true">→</b>
              </span>
            </a>
          ))
        }
      </nav>
    </StoryEnd>
  </div>
</BaseLayout>

<script>
  import '../../../scripts/story';
</script>
