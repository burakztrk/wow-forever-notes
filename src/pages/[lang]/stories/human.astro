---
// Race story: Human. Copy in src/i18n/stories.ts, drawings in
// src/lib/stories/human-art.ts (generated by scripts/stories/human_art.py), scroll
// effects in src/scripts/story.ts, styles in src/styles/stories.css (all scoped under .lore).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CurseLink from '../../../components/stories/CurseLink.astro';
import RaceChips from '../../../components/stories/RaceChips.astro';
import StoryEnd from '../../../components/stories/StoryEnd.astro';
import StoryHeader from '../../../components/stories/StoryHeader.astro';
import { LANGS, type Lang } from '../../../config';
import { ui } from '../../../i18n';
import { HUMAN_ART_LABELS, HUMAN_STORY, STORY_UI } from '../../../i18n/stories';
import { fillArt } from '../../../lib/stories/art';
import { HUMAN_ART } from '../../../lib/stories/human-art';
import { loreHtml, loreIds, loreTips } from '../../../lib/stories/lore';
import { islandJson } from '../../../lib/tooltip-payload';
import { curseUrl, withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const s = HUMAN_STORY[lang];
const u = STORY_UI[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/stories/human/`)])) as Record<Lang, string>;
const base = withBase('/');
const art = (svg: string) => fillArt(svg, HUMAN_ART_LABELS[lang], base);
const img = (name: string) => withBase(`/stories/human/${name}`);
const ic = HUMAN_ART.icons;
// proper names in the text get lore tooltips (src/i18n/lore.ts); the cards ride in the #wf-glossary island
const lx = (text: string) => loreHtml(text);
const tips = loreTips(lang, loreIds(s));

const chapters = [
  { id: 'origin', num: 'I', name: s.chapters.origin },
  { id: 'arathor', num: 'II', name: s.chapters.arathor },
  { id: 'wars', num: 'III', name: s.chapters.wars },
  { id: 'fall', num: 'IV', name: s.chapters.fall },
  { id: 'today', num: 'V', name: s.chapters.today },
];
const stageIcons = [
  // Titan
  '<circle cx="32" cy="32" r="22"/><path d="M32 14 47.6 41H16.4Z"/><circle cx="32" cy="32" r="3.5" fill="currentColor" stroke="none"/><path d="M32 4v6M32 54v6M4 32h6M54 32h6"/>',
  // vrykul: horned helm over a broad, bearded face
  '<path d="M17 27c0-10 7-16 15-16s15 6 15 16Z"/><path d="M17 22C10 20 7 13 9 6c2 6 6 9 10 9M47 22c7-2 10-9 8-16-2 6-6 9-10 9"/><path d="M14 27h36"/><circle cx="25" cy="33" r="2" fill="currentColor" stroke="none"/><circle cx="39" cy="33" r="2" fill="currentColor" stroke="none"/><path d="M16 31c0 15 7 26 16 28 9-2 16-13 16-28"/><path d="M25 45c2 5 4 8 7 9 3-1 5-4 7-9"/>',
  // Curse of Flesh: a large figure beside a small one
  '<circle cx="22" cy="14" r="7"/><path d="M12 58V34c0-7 4-12 10-12s10 5 10 12v24"/><circle cx="46" cy="36" r="4.5"/><path d="M40 58V48c0-4 2.5-6.5 6-6.5s6 2.5 6 6.5v10"/><circle cx="56" cy="14" r="1.6" fill="currentColor" stroke="none"/><circle cx="60" cy="21" r="1.1" fill="currentColor" stroke="none"/><circle cx="51" cy="8" r="1.1" fill="currentColor" stroke="none"/>',
  // human: head and shoulders under a simple crown
  '<path d="M23 17 21 7l6 4 5-6 5 6 6-4-2 10Z"/><circle cx="32" cy="28" r="10"/><path d="M12 58c0-11 9-19 20-19s20 8 20 19"/><path d="M27 46l5 5 5-5"/>',
];
const warIcons = [ic.dagger, ic.camp, ic.cracked, ic.castle];
const fallIcons = [ic.flame, ic.runeblade, ic.brokenCrown, ic.ship];
const throneIcons = [ic.crown, ic.smallCrown, ic.shield];
const throneColor = ['var(--gold)', 'var(--gold)', 'var(--alliance)'];
const delay = (i: number) => `--d:${(i * 0.08).toFixed(2)}s`;
---

<BaseLayout title={`Human · ${t.storiesTitle}`} description={s.metaDescription} lang={lang} alternates={alternates} full>
  <div class="lore" id="lore">
    <StoryHeader lang={lang} chapters={chapters} icon={ic.brand} />

    <section class="hero gate" aria-labelledby="h-human">
      <div class="hero-bg" aria-hidden="true"><img src={img('stormwind-gate.webp')} alt="" width="1920" height="810" /></div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="wrap hero-in">
        <div class="hero-col">
          <RaceChips lang={lang} current="human" />
          <div class="hero-copy">
            <p class="ov">{s.overline} · <span lang="en">Alliance</span></p>
            <h1 class="h1" id="h-human">Human</h1>
            <p class="lead">{s.lead}</p>
            <a class="cue" href="#origin">{u.cue} <b aria-hidden="true">↓</b></a>
          </div>
        </div>
      </div>
    </section>

    <section class="facts" aria-label="Human">
      <dl class="wrap">
        {
          s.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>
                <Fragment set:html={lx(fact.value)} />
                {fact.extra && (
                  <span>
                    {' · '}
                    <Fragment set:html={lx(fact.extra)} />
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- I · origin -->
    <section class="chap chap-bg" id="origin" aria-labelledby="h-origin">
      <div class="chap-art statue" aria-hidden="true"><img src={img('lothar-statue.webp')} alt="" width="480" height="760" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">I</div>
          <div>
            <p class="ov">{u.chapter} I · {s.chapters.origin}</p>
            <h2 class="h2" id="h-origin">{s.origin.title} <a lang="en" class="title-note" href={curseUrl(lang)}>{s.origin.titleNote}</a></h2>
          </div>
        </header>
        <div class="prose rv">{s.origin.paragraphs.map((p) => <p set:html={lx(p)} />)}</div>
        <div class="evo-wrap" id="evo" data-p=".95,.35">
          <ol class="evo" aria-label={s.origin.stagesLabel}>
            <li class="evo-line" aria-hidden="true"><i></i></li>
            {
              s.origin.stages.map((stage, i) => (
                <li class="stage rv" style={delay(i)}>
                  <div class="ico">
                    <svg viewBox="0 0 64 64" aria-hidden="true" set:html={stageIcons[i]} />
                  </div>
                  <div class="t">
                    <h3>{stage.name}</h3>
                    <p>{stage.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="mf" aria-hidden="true"><span>{s.origin.giant}</span><div class="mf-bar"><b></b></div><span>{s.origin.human}</span></div>
        </div>
        <CurseLink lang={lang} />
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.origin.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- II · Arathor -->
    <section class="chap" id="arathor" aria-labelledby="h-arathor">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">II</div>
          <div><p class="ov">{u.chapter} II · {s.chapters.arathor}</p><h2 class="h2" id="h-arathor">{s.arathor.title}</h2></div>
        </header>
        <div class="prose rv">{[s.arathor.intro, ...s.arathor.more].map((p) => <p set:html={lx(p)} />)}</div>
        <div class="scene solo">
          <div class="stat plain light rv" style="--d:.1s">
            <p class="ov stat-ov">{s.arathor.statLabel}</p>
            <p class="stat-n" aria-label={s.arathor.statAria}><span class="count" data-to="100">100</span><span class="stat-u">{s.arathor.statUnit}</span></p>
            <p set:html={s.arathor.statText} />
            <p class="small" set:html={lx(s.arathor.statDetail)} />
          </div>
        </div>
        <div class="sub rv"><p class="ov">{s.arathor.kingdomsLabel}</p><h3 class="h3">{s.arathor.kingdomsTitle}</h3></div>
        <figure class="map-fig rv" id="kingdoms" data-p=".72,.22" data-routes>
          <Fragment set:html={art(HUMAN_ART.kingdoms)} />
          <figcaption>
            <span>{s.arathor.mapCaption}</span>
            <span class="keys"><span class="key"><i></i>{s.arathor.routesKey}</span></span>
          </figcaption>
          <ol class="legend" style="--cols:4">
            {
              s.arathor.legend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    <Fragment set:html={lx(item.text)} />
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.arathor.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- III · wars -->
    <section class="chap" id="wars" aria-labelledby="h-wars">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">III</div>
          <div><p class="ov">{u.chapter} III · {s.chapters.wars}</p><h2 class="h2" id="h-wars">{s.wars.title}</h2></div>
        </header>
        <div class="prose rv"><p set:html={lx(s.wars.intro)} /></div>
        <div class="story" id="story" data-step="1">
          <ol class="steps">
            {
              s.wars.steps.map((step, i) => (
                <li class:list={['step', { active: i === 0 }]} data-era={step.era} data-title={step.title}>
                  <p class="ov" lang="en">{step.era}</p>
                  <h3 class="h3">{step.title}</h3>
                  <p set:html={lx(step.text)} />
                  <span class:list={['status', step.tone]}>
                    <i />
                    {step.status}
                  </span>
                </li>
              ))
            }
          </ol>
          <figure class="stage-map" aria-label={s.wars.mapLabel}>
            <figcaption class="map-cap">
              <span class="t"
                ><span class="ov" id="capEra" lang="en">{s.wars.steps[0].era}</span><span id="capTitle">{s.wars.steps[0].title}</span></span
              >
              <span class="dots" aria-hidden="true">{s.wars.steps.map((_, i) => <i class:list={{ on: i === 0 }} />)}</span>
            </figcaption>
            <Fragment set:html={art(HUMAN_ART.ek)} />
          </figure>
        </div>
        <div class="war-cards">
          {
            s.wars.cards.map((card, i) => (
              <article class="card rv" style={delay(i % 2)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={warIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p set:html={lx(card.text)} />
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.wars.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- IV · the fall of Lordaeron -->
    <section class="chap" id="fall" aria-labelledby="h-fall">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">IV</div>
          <div><p class="ov">{u.chapter} IV · {s.chapters.fall}</p><h2 class="h2" id="h-fall">{s.fall.title}</h2></div>
        </header>
        <div class="prose rv">{[s.fall.intro, ...s.fall.more].map((p) => <p set:html={lx(p)} />)}</div>
        <figure class="map-fig rv" id="plague" data-p=".72,.22" data-routes>
          <Fragment set:html={art(HUMAN_ART.plague)} />
          <figcaption>
            <span>{s.fall.mapCaption}</span>
            <span class="keys"
              ><span class="key void"><i></i>{s.fall.plagueKey}</span><span class="key rage"><i></i>{s.fall.arthasKey}</span><span class="key al"
                ><i></i>{s.fall.jainaKey}</span
              ></span
            >
          </figcaption>
          <ol class="legend" style="--cols:4">
            {
              s.fall.legend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    <Fragment set:html={lx(item.text)} />
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
        <div class="war-cards">
          {
            s.fall.cards.map((card, i) => (
              <article class="card rv" style={delay(i % 2)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={fallIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p set:html={lx(card.text)} />
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.fall.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- V · today -->
    <section class="chap" id="today" aria-labelledby="h-today">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">V</div>
          <div><p class="ov">{u.chapter} V · {s.chapters.today}</p><h2 class="h2" id="h-today">{s.today.title}</h2></div>
        </header>
        <div class="prose rv">{s.today.intro.map((p) => <p set:html={lx(p)} />)}</div>
        <div class="sub rv"><p class="ov">{s.today.throneLabel}</p><p class="council-text">{s.today.throneText}</p></div>
        <div class="clans">
          {
            s.today.throne.map((member, i) => (
              <article class="card clan rv" style={`--clan:${throneColor[i]};${delay(i)}`}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={throneIcons[i]} />
                </div>
                <p class="ov">{member.role}</p>
                <h3 class="h3">{member.name}</h3>
                <p set:html={lx(member.text)} />
              </article>
            ))
          }
        </div>

        <div class="sub rv"><p class="ov">{s.today.defiasLabel}</p><h3 class="h3">{s.today.defiasTitle}</h3></div>
        <div class="prose rv">{s.today.defiasText.map((p) => <p set:html={lx(p)} />)}</div>
        <figure class="map-fig rv" id="westfall" data-p=".72,.22" data-routes>
          <Fragment set:html={art(HUMAN_ART.westfall)} />
          <figcaption>
            <span>{s.today.westfallCaption}</span>
            <span class="keys"><span class="key rage"><i></i>{s.today.defiasKey}</span></span>
          </figcaption>
          <ol class="legend">
            {
              s.today.westfallLegend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    <Fragment set:html={lx(item.text)} />
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
      </div>
    </section>

    <section class="chap tight" aria-labelledby="h-beyond">
      <div class="wrap">
        <div class="sub rv"><p class="ov">{s.today.beyondLabel}</p><h3 class="h3" id="h-beyond">{s.today.beyondTitle}</h3></div>
        <div class="prose rv">{s.today.beyondText.map((p) => <p set:html={lx(p)} />)}</div>
        <figure class="map-fig rv" id="world" data-p=".72,.22" data-routes>
          <Fragment set:html={art(HUMAN_ART.world)} />
          <figcaption>
            <span>{s.today.mapCaption}</span>
            <span class="keys"><span class="key"><i></i>{s.today.routesKey}</span></span>
          </figcaption>
          <ol class="legend">
            {
              s.today.legend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    <Fragment set:html={lx(item.text)} />
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.today.note)} /></aside>
      </div>
    </section>

    <StoryEnd lang={lang} title={s.outro.title} text={s.outro.text} next="Night Elf" nextText={s.outro.nextText} images={s.images} />
  </div>
  <script slot="after" type="application/json" id="wf-glossary" is:inline set:html={islandJson(tips)} />
</BaseLayout>

<script>
  import '../../../scripts/story';
</script>
