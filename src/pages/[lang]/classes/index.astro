---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGS, type Lang } from '../../../config';
import { fill, ui } from '../../../i18n';
import { classList } from '../../../lib/codex';
import { withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/classes/`)])) as Record<Lang, string>;
---

<BaseLayout title={t.classesTitle} description={t.classesIntro} lang={lang} alternates={alternates} wide>
  <h1>{t.classesTitle}</h1>
  <p class="muted">{t.classesIntro}</p>
  <ul class="tile-grid">
    {
      classList.map((c) => (
        <li>
          <a class="tile" href={withBase(`/${lang}/classes/${c.id}/`)} style={`--tile-color: var(--class-${c.id})`}>
            {c.icon && <img src={withBase(`/icons/${c.icon}.jpg`)} alt="" width="44" height="44" loading="lazy" />}
            {c.name}
            <small>{fill(t.spellCount, { n: c.spells.length })}</small>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
