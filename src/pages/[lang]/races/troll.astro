---
// Race story: Troll. Copy in src/i18n/stories.ts, drawings in
// src/lib/stories/troll-art.ts (generated by scripts/stories/troll_art.py), scroll
// effects in src/scripts/story.ts, styles in src/styles/stories.css (all scoped under .lore).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RaceChips from '../../../components/stories/RaceChips.astro';
import StoryEnd from '../../../components/stories/StoryEnd.astro';
import StoryHeader from '../../../components/stories/StoryHeader.astro';
import StoryLinks from '../../../components/stories/StoryLinks.astro';
import { LANGS, type Lang } from '../../../config';
import { ui } from '../../../i18n';
import { STORY_UI, TROLL_ART_LABELS, TROLL_STORY } from '../../../i18n/stories';
import { fillArt } from '../../../lib/stories/art';
import { loreHtml, loreIds, loreTips } from '../../../lib/stories/lore';
import { TROLL_ART } from '../../../lib/stories/troll-art';
import { islandJson } from '../../../lib/tooltip-payload';
import { withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const s = TROLL_STORY[lang];
const u = STORY_UI[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/races/troll/`)])) as Record<Lang, string>;
const art = (svg: string) => fillArt(svg, TROLL_ART_LABELS[lang], withBase('/'));
const ic = TROLL_ART.icons;
const img = (name: string) => withBase(`/stories/troll/${name}`);
// proper names in the text get lore tooltips (src/i18n/lore.ts); the cards ride in the #wf-glossary island
const lx = (text: string) => loreHtml(text);
const tips = loreTips(lang, loreIds(s));

const chapters = [
  { id: 'origin', num: 'I', name: s.chapters.origin },
  { id: 'amani', num: 'II', name: s.chapters.amani },
  { id: 'gurubashi', num: 'III', name: s.chapters.gurubashi },
  { id: 'darkspear', num: 'IV', name: s.chapters.darkspear },
  { id: 'today', num: 'V', name: s.chapters.today },
];
const stageIcons = [ic.mask, ic.serpent, ic.insect, ic.spears];
const amaniIcons = [ic.axe, ic.swords, ic.skullspear, ic.tusk];
const guruIcons = [ic.blood, ic.flame, ic.idol, ic.spear];
const leaderIcons = [ic.maskc, ic.staff, ic.eye];
const leaderColor = ['var(--jungle)', 'var(--gold)', 'var(--horde)'];
const delay = (i: number) => `--d:${(i * 0.08).toFixed(2)}s`;
---

<BaseLayout title={`Troll · ${t.storiesTitle}`} description={s.metaDescription} lang={lang} alternates={alternates} full>
  <div class="lore troll" id="lore">
    <StoryHeader lang={lang} chapters={chapters} icon={ic.brand} />

    <section class="hero troll-cover" aria-labelledby="h-troll">
      <div class="hero-bg" aria-hidden="true"><img src={img('durotar.webp')} alt="" width="1210" height="1619" /></div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="sil sil-voljin" aria-hidden="true"><img src={img('voljin.webp')} alt="" width="760" height="1064" /></div>
      <canvas id="snow" data-fx="voodoo" aria-hidden="true"></canvas>
      <div class="wrap hero-in">
        <div class="hero-col">
          <RaceChips lang={lang} current="troll" />
          <div class="hero-copy">
            <p class="ov">{s.overline} · <span lang="en">Horde</span></p>
            <h1 class="h1" id="h-troll" lang="en">Troll</h1>
            <p class="lead">{s.lead}</p>
            <a class="cue" href="#origin">{u.cue} <b aria-hidden="true">↓</b></a>
          </div>
        </div>
      </div>
      <StoryLinks lang={lang} kind="race" slug="troll" />
    </section>

    <section class="facts" aria-label="Troll">
      <dl class="wrap">
        {
          s.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>
                <Fragment set:html={lx(fact.value)} />
                {fact.extra && (
                  <span>
                    {' · '}
                    <Fragment set:html={lx(fact.extra)} />
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- I · origin -->
    <section class="chap" id="origin" aria-labelledby="h-origin">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">I</div>
          <div>
            <p class="ov">{u.chapter} I · {s.chapters.origin}</p>
            <h2 class="h2" id="h-origin">{s.origin.title} <span lang="en" class="title-note">{s.origin.titleNote}</span></h2>
          </div>
        </header>
        <div class="prose rv">{s.origin.paragraphs.map((p) => <p set:html={lx(p)} />)}</div>
        <div class="evo-wrap" id="evo" data-p=".95,.35">
          <ol class="evo" aria-label={s.origin.stagesLabel}>
            <li class="evo-line" aria-hidden="true"><i></i></li>
            {
              s.origin.stages.map((stage, i) => (
                <li class="stage rv" style={delay(i)}>
                  <div class="ico">
                    <svg viewBox="0 0 64 64" aria-hidden="true" set:html={stageIcons[i]} />
                  </div>
                  <div class="t">
                    <h3>{stage.name}</h3>
                    <p>{stage.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="mf" aria-hidden="true"><span>{s.origin.before}</span><div class="mf-bar"><b></b></div><span>{s.origin.after}</span></div>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.origin.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- II · the Amani -->
    <section class="chap chap-bg" id="amani" aria-labelledby="h-amani">
      <div class="chap-art top" aria-hidden="true"><img src={img('zulaman.webp')} alt="" width="1200" height="857" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">II</div>
          <div><p class="ov">{u.chapter} II · {s.chapters.amani}</p><h2 class="h2" id="h-amani">{s.amani.title}</h2></div>
        </header>
        <div class="split top">
          <div class="prose rv">{[s.amani.intro, ...s.amani.more].map((p) => <p set:html={lx(p)} />)}</div>
          <figure class="map-fig rv" id="amanimap" data-p=".8,.15" data-routes>
            <Fragment set:html={art(TROLL_ART.amani)} />
            <figcaption>
              <span>{s.amani.figureCaption}</span>
              <span class="keys">
                <span class="key rage"><i></i>{s.amani.amaniKey}</span>
                <span class="key al"><i></i>{s.amani.allianceKey}</span>
                <span class="key horde"><i></i>{s.amani.hordeKey}</span>
              </span>
            </figcaption>
            <ol class="legend" style="--cols:1">
              {
                s.amani.legend.map((item, i) => (
                  <li>
                    <span class="lk">{i + 1}</span>
                    <span>
                      <b>{item.name}</b>
                      <Fragment set:html={lx(item.text)} />
                    </span>
                  </li>
                ))
              }
            </ol>
          </figure>
        </div>
        <div class="war-cards">
          {
            s.amani.cards.map((card, i) => (
              <article class="card rv" style={delay(i % 2)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={amaniIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p set:html={lx(card.text)} />
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.amani.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- III · the Gurubashi -->
    <section class="chap" id="gurubashi" aria-labelledby="h-gurubashi">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">III</div>
          <div><p class="ov">{u.chapter} III · {s.chapters.gurubashi}</p><h2 class="h2" id="h-gurubashi">{s.gurubashi.title}</h2></div>
        </header>
        <div class="split top">
          <div class="prose rv">{[s.gurubashi.intro, ...s.gurubashi.more].map((p) => <p set:html={lx(p)} />)}</div>
          <figure class="map-fig rv" id="stvmap" data-p=".8,.15" data-routes>
            <Fragment set:html={art(TROLL_ART.gurubashi)} />
            <figcaption>
              <span>{s.gurubashi.figureCaption}</span>
              <span class="keys">
                <span class="key void"><i></i>{s.gurubashi.templeKey}</span>
                <span class="key"><i></i>{s.gurubashi.exileKey}</span>
              </span>
            </figcaption>
            <ol class="legend" style="--cols:1">
              {
                s.gurubashi.legend.map((item, i) => (
                  <li>
                    <span class="lk">{i + 1}</span>
                    <span>
                      <b>{item.name}</b>
                      <Fragment set:html={lx(item.text)} />
                    </span>
                  </li>
                ))
              }
            </ol>
          </figure>
        </div>
        <div class="war-cards">
          {
            s.gurubashi.cards.map((card, i) => (
              <article class="card rv" style={delay(i % 2)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={guruIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p set:html={lx(card.text)} />
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.gurubashi.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- IV · the Darkspear -->
    <section class="chap chap-bg" id="darkspear" aria-labelledby="h-darkspear">
      <div class="chap-art top pano" aria-hidden="true"><img src={img('senjin-village.webp')} alt="" width="739" height="415" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">IV</div>
          <div><p class="ov">{u.chapter} IV · {s.chapters.darkspear}</p><h2 class="h2" id="h-darkspear">{s.darkspear.title}</h2></div>
        </header>
        <div class="prose rv"><p set:html={lx(s.darkspear.intro)} /></div>
        <div class="story" id="story" data-step="1">
          <ol class="steps">
            {
              s.darkspear.steps.map((step, i) => (
                <li class:list={['step', { active: i === 0 }]} data-era={step.era} data-title={step.title}>
                  <p class="ov" lang="en">{step.era}</p>
                  <h3 class="h3">{step.title}</h3>
                  <p set:html={lx(step.text)} />
                  <span class:list={['status', step.tone]}>
                    <i />
                    {step.status}
                  </span>
                </li>
              ))
            }
          </ol>
          <figure class="stage-map" aria-label={s.darkspear.mapLabel}>
            <figcaption class="map-cap">
              <span class="t"
                ><span class="ov" id="capEra" lang="en">{s.darkspear.steps[0].era}</span><span id="capTitle">{s.darkspear.steps[0].title}</span></span
              >
              <span class="dots" aria-hidden="true">{s.darkspear.steps.map((_, i) => <i class:list={{ on: i === 0 }} />)}</span>
            </figcaption>
            <Fragment set:html={art(TROLL_ART.ek)} />
          </figure>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.darkspear.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- V · today -->
    <section class="chap chap-bg" id="today" aria-labelledby="h-today">
      <div class="chap-art top dim" aria-hidden="true"><img src={img('durotar.webp')} alt="" width="1210" height="1619" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">V</div>
          <div><p class="ov">{u.chapter} V · {s.chapters.today}</p><h2 class="h2" id="h-today">{s.today.title}</h2></div>
        </header>
        <div class="prose rv">{s.today.intro.map((p) => <p set:html={lx(p)} />)}</div>
        <div class="sub rv"><p class="ov">{s.today.leadersLabel}</p><p class="council-text">{s.today.leadersText}</p></div>
        <div class="clans">
          {
            s.today.leaders.map((leader, i) => (
              <article class="card clan rv" style={`--clan:${leaderColor[i]};${delay(i)}`}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={leaderIcons[i]} />
                </div>
                <p class="ov">{leader.role}</p>
                <h3 class="h3">{leader.name}</h3>
                <p set:html={lx(leader.text)} />
              </article>
            ))
          }
        </div>

        <div class="sub rv"><p class="ov">{s.today.tribesLabel}</p><h3 class="h3">{s.today.tribesTitle}</h3></div>
        <div class="prose rv">{s.today.tribesText.map((p) => <p set:html={lx(p)} />)}</div>
        <ul class="tribes">
          {
            s.today.tribes.map((tribe, i) => (
              <li class="rv" style={delay(i % 2)}>
                <span class:list={['status', tribe.tone]}>
                  <i />
                </span>
                <span class="tb">
                  <b set:html={lx(tribe.name)} />
                  <span class="kind">{tribe.kind}</span>
                  <span class="where" set:html={lx(tribe.place)} />
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="chap tight" aria-labelledby="h-world">
      <div class="wrap">
        <figure class="map-fig rv" id="world" aria-labelledby="h-world">
          <Fragment set:html={art(TROLL_ART.world)} />
          <figcaption>
            <span id="h-world">{s.today.mapCaption}</span>
          </figcaption>
          <ol class="legend">
            {
              s.today.legend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    <Fragment set:html={lx(item.text)} />
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.today.note)} /></aside>
      </div>
    </section>

    <StoryEnd lang={lang} title={s.outro.title} text={s.outro.text} next="Tauren" nextText={s.outro.nextText} images={s.images} />
  </div>
  <script slot="after" type="application/json" id="wf-glossary" is:inline set:html={islandJson(tips)} />
</BaseLayout>

<script>
  import '../../../scripts/story';
</script>
