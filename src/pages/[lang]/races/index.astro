---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGS, type Lang } from '../../../config';
import { ui } from '../../../i18n';
import { classesOf, racesByFaction } from '../../../lib/codex';
import { storyRace } from '../../../lib/stories/races';
import { withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/races/`)])) as Record<Lang, string>;
const icon = (name?: string) => (name ? withBase(`/icons/${name}.jpg`) : undefined);
---

<BaseLayout title={t.racesTitle} description={t.racesIntro} lang={lang} alternates={alternates} wide>
  <h1>{t.racesTitle}</h1>
  <p class="muted">{t.racesIntro}</p>
  {
    racesByFaction().map(([faction, list]) => (
      <section>
        <h2 class:list={['codex-section', `faction-title--${faction.toLowerCase()}`]}>{faction}</h2>
        <ul class="race-grid">
          {list.map((race) => {
            const cover = storyRace(race.id)?.cover;
            return (
              <li>
                <a
                  class:list={['race-card', { 'has-cover': !!cover }]}
                  href={withBase(`/${lang}/races/${race.id}/`)}
                  style={`--faction-color: ${faction === 'Horde' ? '#e0503c' : '#4a8fe7'}`}
                >
                  {cover && (
                    <img class="race-card-bg" src={withBase(cover.src)} alt="" loading="lazy" style={`object-position:${cover.position}`} />
                  )}
                  <span class="race-card-head">
                    {race.icon ? <img src={icon(race.icon)} alt="" width="40" height="40" loading="lazy" /> : <span class="blank" />}
                    {race.name}
                  </span>
                  <span class="mini-icons">
                    {classesOf(race).map((c) => (
                      <img src={icon(c.icon)} alt={c.name} title={c.name} width="20" height="20" loading="lazy" />
                    ))}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</BaseLayout>
