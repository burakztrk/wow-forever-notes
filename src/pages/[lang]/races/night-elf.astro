---
// Race story: Night Elf. Copy in src/i18n/stories.ts, drawings in
// src/lib/stories/night-elf-art.ts (generated by scripts/stories/night_elf_art.py), scroll
// effects in src/scripts/story.ts, styles in src/styles/stories.css (all scoped under .lore).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RaceChips from '../../../components/stories/RaceChips.astro';
import StoryEnd from '../../../components/stories/StoryEnd.astro';
import StoryHeader from '../../../components/stories/StoryHeader.astro';
import StoryLinks from '../../../components/stories/StoryLinks.astro';
import { LANGS, type Lang } from '../../../config';
import { ui } from '../../../i18n';
import { NIGHT_ELF_ART_LABELS, NIGHT_ELF_STORY, STORY_UI } from '../../../i18n/stories';
import { fillArt } from '../../../lib/stories/art';
import { loreHtml, loreIds, loreTips } from '../../../lib/stories/lore';
import { NIGHT_ELF_ART } from '../../../lib/stories/night-elf-art';
import { islandJson } from '../../../lib/tooltip-payload';
import { withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const s = NIGHT_ELF_STORY[lang];
const u = STORY_UI[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/races/night-elf/`)])) as Record<Lang, string>;
const art = (svg: string) => fillArt(svg, NIGHT_ELF_ART_LABELS[lang], withBase('/'));
const img = (name: string) => withBase(`/stories/night-elf/${name}`);
const ic = NIGHT_ELF_ART.icons;
// proper names in the text get lore tooltips (src/i18n/lore.ts); the cards ride in the #wf-glossary island
const lx = (text: string) => loreHtml(text);
const tips = loreTips(lang, loreIds(s));

const chapters = [
  { id: 'origin', num: 'I', name: s.chapters.origin },
  { id: 'sundering', num: 'II', name: s.chapters.sundering },
  { id: 'vigil', num: 'III', name: s.chapters.vigil },
  { id: 'hyjal', num: 'IV', name: s.chapters.hyjal },
  { id: 'today', num: 'V', name: s.chapters.today },
];
const stageIcons = [ic.troll, ic.well, ic.elune, ic.kaldorei];
const sunderIcons = [ic.crown, ic.demon, ic.antlers, ic.vial];
const placeIcons = [ic.tree, ic.glade, ic.scarab];
const leaderIcons = [ic.moon, ic.staff, ic.dream];
const leaderColor = ['var(--elune)', 'var(--leaf)', 'var(--text-mute)'];
const delay = (i: number) => `--d:${(i * 0.08).toFixed(2)}s`;
---

<BaseLayout title={`Night Elf · ${t.storiesTitle}`} description={s.metaDescription} lang={lang} alternates={alternates} full heroImage={img('well-of-eternity.webp')}>
  <div class="lore night" id="lore">
    <StoryHeader lang={lang} chapters={chapters} icon={ic.brand} />

    <section class="hero well" aria-labelledby="h-night-elf">
      <div class="hero-bg" aria-hidden="true"><img src={img('well-of-eternity.webp')} alt="" width="1600" height="1068" /></div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="sil sil-queen" aria-hidden="true"><img src={img('azshara.webp')} alt="" width="387" height="516" /></div>
      <canvas id="snow" data-fx="wisps" aria-hidden="true"></canvas>
      <div class="wrap hero-in">
        <RaceChips lang={lang} current="night-elf" />
        <div class="hero-col">
          <div class="hero-copy">
            <p class="ov">{s.overline} · <span lang="en">Alliance</span></p>
            <h1 class="h1" id="h-night-elf" lang="en">Night Elf</h1>
            <p class="lead">{s.lead}</p>
            <a class="cue" href="#origin">{u.cue} <b aria-hidden="true">↓</b></a>
          </div>
        </div>
      </div>
      <StoryLinks lang={lang} kind="race" slug="night-elf" />
    </section>

    <section class="facts" aria-label="Night Elf">
      <dl class="wrap">
        {
          s.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>
                <Fragment set:html={lx(fact.value)} />
                {fact.extra && (
                  <span>
                    {' · '}
                    <Fragment set:html={lx(fact.extra)} />
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- I · origin -->
    <section class="chap" id="origin" aria-labelledby="h-origin">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">I</div>
          <div>
            <p class="ov">{u.chapter} I · {s.chapters.origin}</p>
            <h2 class="h2" id="h-origin">{s.origin.title} <span lang="en" class="title-note">{s.origin.titleNote}</span></h2>
          </div>
        </header>
        <div class="prose rv">{s.origin.paragraphs.map((p) => <p set:html={lx(p)} />)}</div>
        <div class="evo-wrap" id="evo" data-p=".95,.35">
          <ol class="evo" aria-label={s.origin.stagesLabel}>
            <li class="evo-line" aria-hidden="true"><i></i></li>
            {
              s.origin.stages.map((stage, i) => (
                <li class="stage rv" style={delay(i)}>
                  <div class="ico">
                    <svg viewBox="0 0 64 64" aria-hidden="true" set:html={stageIcons[i]} />
                  </div>
                  <div class="t">
                    <h3>{stage.name}</h3>
                    <p>{stage.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="mf" aria-hidden="true"><span>{s.origin.before}</span><div class="mf-bar"><b></b></div><span>{s.origin.after}</span></div>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.origin.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- II · the Sundering -->
    <section class="chap chap-bg" id="sundering" aria-labelledby="h-sundering">
      <div class="chap-art top well-art" aria-hidden="true"><img src={img('well-of-eternity.webp')} alt="" width="1600" height="1068" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">II</div>
          <div><p class="ov">{u.chapter} II · {s.chapters.sundering}</p><h2 class="h2" id="h-sundering">{s.sundering.title}</h2></div>
        </header>
        <div class="prose rv">{[s.sundering.intro, ...s.sundering.more].map((p) => <p set:html={lx(p)} />)}</div>
        <figure class="map-fig rv" id="sunder" data-p=".85,.25" data-moves>
          <Fragment set:html={art(NIGHT_ELF_ART.sundering)} />
          <figcaption>{s.sundering.figureCaption}</figcaption>
        </figure>
        <div class="scene solo">
          <div class="stat plain moonstat rv" style="--d:.1s">
            <p class="ov stat-ov">{s.sundering.statLabel}</p>
            <p class="stat-n" aria-label={s.sundering.statAria}><span class="count" data-to="10000">{(10000).toLocaleString(lang)}</span><span class="stat-u">{s.sundering.statUnit}</span></p>
            <p set:html={s.sundering.statText} />
            <p class="small" set:html={lx(s.sundering.statDetail)} />
          </div>
        </div>
        <div class="war-cards">
          {
            s.sundering.cards.map((card, i) => (
              <article class="card rv" style={delay(i % 2)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={sunderIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p set:html={lx(card.text)} />
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.sundering.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- III · the vigil -->
    <section class="chap chap-bg" id="vigil" aria-labelledby="h-vigil">
      <div class="chap-art top" aria-hidden="true"><img src={img('moonglade.webp')} alt="" width="739" height="415" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">III</div>
          <div><p class="ov">{u.chapter} III · {s.chapters.vigil}</p><h2 class="h2" id="h-vigil">{s.vigil.title}</h2></div>
        </header>
        <div class="prose rv">{[s.vigil.intro, ...s.vigil.more].map((p) => <p set:html={lx(p)} />)}</div>
        <div class="trio spaced">
          {
            s.vigil.places.map((place, i) => (
              <article class="card rv" style={delay(i)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={placeIcons[i]} />
                </div>
                <p class="ov">{place.tag}</p>
                <h3 class="h3">{place.name}</h3>
                <p set:html={lx(place.text)} />
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.vigil.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- IV · Hyjal -->
    <section class="chap chap-bg" id="hyjal" aria-labelledby="h-hyjal">
      <div class="chap-art top pano" aria-hidden="true"><img src={img('hyjal.webp')} alt="" width="622" height="240" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">IV</div>
          <div><p class="ov">{u.chapter} IV · {s.chapters.hyjal}</p><h2 class="h2" id="h-hyjal">{s.hyjal.title}</h2></div>
        </header>
        <div class="prose rv"><p set:html={lx(s.hyjal.intro)} /></div>
        <div class="story" id="story" data-step="1">
          <ol class="steps">
            {
              s.hyjal.steps.map((step, i) => (
                <li class:list={['step', { active: i === 0 }]} data-era={step.era} data-title={step.title}>
                  <p class="ov" lang="en">{step.era}</p>
                  <h3 class="h3">{step.title}</h3>
                  <p set:html={lx(step.text)} />
                  <span class:list={['status', step.tone]}>
                    <i />
                    {step.status}
                  </span>
                </li>
              ))
            }
          </ol>
          <figure class="stage-map" aria-label={s.hyjal.mapLabel}>
            <figcaption class="map-cap">
              <span class="t"
                ><span class="ov" id="capEra" lang="en">{s.hyjal.steps[0].era}</span><span id="capTitle">{s.hyjal.steps[0].title}</span></span
              >
              <span class="dots" aria-hidden="true">{s.hyjal.steps.map((_, i) => <i class:list={{ on: i === 0 }} />)}</span>
            </figcaption>
            <Fragment set:html={art(NIGHT_ELF_ART.ek)} />
          </figure>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.hyjal.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- V · today -->
    <section class="chap" id="today" aria-labelledby="h-today">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">V</div>
          <div><p class="ov">{u.chapter} V · {s.chapters.today}</p><h2 class="h2" id="h-today">{s.today.title}</h2></div>
        </header>
        <div class="prose rv">{s.today.intro.map((p) => <p set:html={lx(p)} />)}</div>
        <div class="sub rv"><p class="ov">{s.today.leadersLabel}</p><p class="council-text">{s.today.leadersText}</p></div>
        <div class="clans">
          {
            s.today.leaders.map((leader, i) => (
              <article class="card clan rv" style={`--clan:${leaderColor[i]};${delay(i)}`}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={leaderIcons[i]} />
                </div>
                <p class="ov">{leader.role}</p>
                <h3 class="h3">{leader.name}</h3>
                <p set:html={lx(leader.text)} />
              </article>
            ))
          }
        </div>

        <div class="sub rv"><p class="ov">{s.today.treeLabel}</p><h3 class="h3">{s.today.treeTitle}</h3></div>
        <div class="prose rv">{s.today.treeText.map((p) => <p set:html={lx(p)} />)}</div>
        <figure class="map-fig rv" id="teldrassil" data-p=".72,.22" data-routes>
          <Fragment set:html={art(NIGHT_ELF_ART.teldrassil)} />
          <figcaption>
            <span>{s.today.treeCaption}</span>
            <span class="keys"><span class="key"><i></i>{s.today.boatKey}</span></span>
          </figcaption>
          <ol class="legend" style="--cols:4">
            {
              s.today.treeLegend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    <Fragment set:html={lx(item.text)} />
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
      </div>
    </section>

    <section class="chap tight" aria-labelledby="h-beyond">
      <div class="wrap">
        <div class="sub rv"><p class="ov">{s.today.beyondLabel}</p><h3 class="h3" id="h-beyond">{s.today.beyondTitle}</h3></div>
        <div class="prose rv">{s.today.beyondText.map((p) => <p set:html={lx(p)} />)}</div>
        <figure class="map-fig rv" id="world" data-p=".72,.22" data-routes>
          <Fragment set:html={art(NIGHT_ELF_ART.world)} />
          <figcaption>
            <span>{s.today.mapCaption}</span>
            <span class="keys"><span class="key"><i></i>{s.today.routesKey}</span></span>
          </figcaption>
          <ol class="legend">
            {
              s.today.legend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    <Fragment set:html={lx(item.text)} />
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.today.note)} /></aside>
      </div>
    </section>

    <StoryEnd lang={lang} title={s.outro.title} text={s.outro.text} next="Orc" nextText={s.outro.nextText} images={s.images} />
  </div>
  <script slot="after" type="application/json" id="wf-glossary" is:inline set:html={islandJson(tips)} />
</BaseLayout>

<script>
  import '../../../scripts/story';
</script>
