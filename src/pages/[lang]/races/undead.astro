---
// Race story: Undead (Forsaken). Copy in src/i18n/stories.ts, drawings in
// src/lib/stories/undead-art.ts (generated by scripts/stories/undead_art.py), scroll
// effects in src/scripts/story.ts, styles in src/styles/stories.css (all scoped under .lore).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RaceChips from '../../../components/stories/RaceChips.astro';
import StoryEnd from '../../../components/stories/StoryEnd.astro';
import StoryHeader from '../../../components/stories/StoryHeader.astro';
import StoryLinks from '../../../components/stories/StoryLinks.astro';
import { LANGS, type Lang } from '../../../config';
import { ui } from '../../../i18n';
import { STORY_UI, UNDEAD_ART_LABELS, UNDEAD_STORY } from '../../../i18n/stories';
import { fillArt } from '../../../lib/stories/art';
import { loreHtml, loreIds, loreTips } from '../../../lib/stories/lore';
import { UNDEAD_ART } from '../../../lib/stories/undead-art';
import { islandJson } from '../../../lib/tooltip-payload';
import { withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const s = UNDEAD_STORY[lang];
const u = STORY_UI[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/races/undead/`)])) as Record<Lang, string>;
const art = (svg: string) => fillArt(svg, UNDEAD_ART_LABELS[lang], withBase('/'));
const ic = UNDEAD_ART.icons;
// proper names in the text get lore tooltips (src/i18n/lore.ts); the cards ride in the #wf-glossary island
const lx = (text: string) => loreHtml(text);
const tips = loreTips(lang, loreIds(s));

const chapters = [
  { id: 'origin', num: 'I', name: s.chapters.origin },
  { id: 'scourge', num: 'II', name: s.chapters.scourge },
  { id: 'breaking', num: 'III', name: s.chapters.breaking },
  { id: 'rebellion', num: 'IV', name: s.chapters.rebellion },
  { id: 'today', num: 'V', name: s.chapters.today },
];
const stageIcons = [ic.shaman, ic.throne, ic.plague, ic.scourge];
const scourgeIcons = [ic.runeblade, ic.lich, ic.bow, ic.sunwell];
const breakingIcons = [ic.icecrown, ic.hood, ic.scream, ic.brokenchain];
const leaderIcons = [ic.arrow, ic.wings, ic.flask];
const leaderColor = ['var(--forsaken)', 'var(--horde)', 'var(--plague)'];
const img = (name: string) => withBase(`/stories/undead/${name}`);
const delay = (i: number) => `--d:${(i * 0.08).toFixed(2)}s`;
---

<BaseLayout title={`Undead · ${t.storiesTitle}`} description={s.metaDescription} lang={lang} alternates={alternates} full heroImage={img('tirisfal.webp')}>
  <div class="lore undead" id="lore">
    <StoryHeader lang={lang} chapters={chapters} icon={ic.brand} />

    <section class="hero undead-cover" aria-labelledby="h-undead">
      <div class="hero-bg" aria-hidden="true"><img src={img('tirisfal.webp')} alt="" width="1024" height="431" /></div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="sil sil-sylvanas" aria-hidden="true"><img src={img('sylvanas.webp')} alt="" width="508" height="969" /></div>
      <canvas id="snow" data-fx="plague" aria-hidden="true"></canvas>
      <div class="wrap hero-in">
        <RaceChips lang={lang} current="undead" />
        <div class="hero-col">
          <div class="hero-copy">
            <p class="ov">{s.overline} · <span lang="en">Horde</span></p>
            <h1 class="h1" id="h-undead" lang="en">Undead</h1>
            <p class="lead">{s.lead}</p>
            <a class="cue" href="#origin">{u.cue} <b aria-hidden="true">↓</b></a>
          </div>
        </div>
      </div>
      <StoryLinks lang={lang} kind="race" slug="undead" />
    </section>

    <section class="facts" aria-label="Undead">
      <dl class="wrap">
        {
          s.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>
                <Fragment set:html={lx(fact.value)} />
                {fact.extra && (
                  <span>
                    {' · '}
                    <Fragment set:html={lx(fact.extra)} />
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- I · origin -->
    <section class="chap" id="origin" aria-labelledby="h-origin">
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">I</div>
          <div>
            <p class="ov">{u.chapter} I · {s.chapters.origin}</p>
            <h2 class="h2" id="h-origin">{s.origin.title} <span lang="en" class="title-note">{s.origin.titleNote}</span></h2>
          </div>
        </header>
        <div class="prose rv">{s.origin.paragraphs.map((p) => <p set:html={lx(p)} />)}</div>
        <div class="evo-wrap" id="evo" data-p=".95,.35">
          <ol class="evo" aria-label={s.origin.stagesLabel}>
            <li class="evo-line" aria-hidden="true"><i></i></li>
            {
              s.origin.stages.map((stage, i) => (
                <li class="stage rv" style={delay(i)}>
                  <div class="ico">
                    <svg viewBox="0 0 64 64" aria-hidden="true" set:html={stageIcons[i]} />
                  </div>
                  <div class="t">
                    <h3>{stage.name}</h3>
                    <p>{stage.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="mf" aria-hidden="true"><span>{s.origin.before}</span><div class="mf-bar"><b></b></div><span>{s.origin.after}</span></div>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.origin.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- II · the Scourge and the fall of two kingdoms -->
    <section class="chap chap-bg" id="scourge" aria-labelledby="h-scourge">
      <div class="chap-art top lordaeron-art" aria-hidden="true"><img src={img('lordaeron.webp')} alt="" width="399" height="501" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">II</div>
          <div><p class="ov">{u.chapter} II · {s.chapters.scourge}</p><h2 class="h2" id="h-scourge">{s.scourge.title}</h2></div>
        </header>
        <div class="split top">
          <div class="prose rv">{[s.scourge.intro, ...s.scourge.more].map((p) => <p set:html={lx(p)} />)}</div>
          <figure class="map-fig rv" id="scourgemap" data-p=".8,.15" data-routes>
            <Fragment set:html={art(UNDEAD_ART.scourge)} />
            <figcaption>
              <span>{s.scourge.figureCaption}</span>
              <span class="keys">
                <span class="key void"><i></i>{s.scourge.plagueKey}</span>
                <span class="key rage"><i></i>{s.scourge.arthasKey}</span>
              </span>
            </figcaption>
            <ol class="legend" style="--cols:1">
              {
                s.scourge.legend.map((item, i) => (
                  <li>
                    <span class="lk">{i + 1}</span>
                    <span>
                      <b>{item.name}</b>
                      <Fragment set:html={lx(item.text)} />
                    </span>
                  </li>
                ))
              }
            </ol>
          </figure>
        </div>
        <div class="war-cards">
          {
            s.scourge.cards.map((card, i) => (
              <article class="card rv" style={delay(i % 2)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={scourgeIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p set:html={lx(card.text)} />
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.scourge.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- III · the cracked throne and the return of free will -->
    <section class="chap chap-bg" id="breaking" aria-labelledby="h-breaking">
      <div class="chap-art top arthas-art" aria-hidden="true"><img src={img('arthas.webp')} alt="" width="1024" height="768" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">III</div>
          <div><p class="ov">{u.chapter} III · {s.chapters.breaking}</p><h2 class="h2" id="h-breaking">{s.breaking.title}</h2></div>
        </header>
        <div class="prose rv">{[s.breaking.intro, ...s.breaking.more].map((p) => <p set:html={lx(p)} />)}</div>
        <div class="war-cards">
          {
            s.breaking.cards.map((card, i) => (
              <article class="card rv" style={delay(i % 2)}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={breakingIcons[i]} />
                </div>
                <div class="t">
                  <h3 class="h3">{card.name}</h3>
                  <p set:html={lx(card.text)} />
                  <span class:list={['status', card.tone]}>
                    <i />
                    {card.status}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.breaking.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- IV · the rebellion in Lordaeron -->
    <section class="chap chap-bg" id="rebellion" aria-labelledby="h-rebellion">
      <div class="chap-art top pano" aria-hidden="true"><img src={img('undercity.webp')} alt="" width="1024" height="626" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">IV</div>
          <div><p class="ov">{u.chapter} IV · {s.chapters.rebellion}</p><h2 class="h2" id="h-rebellion">{s.rebellion.title}</h2></div>
        </header>
        <div class="prose rv"><p set:html={lx(s.rebellion.intro)} /></div>
        <div class="story" id="story" data-step="1">
          <ol class="steps">
            {
              s.rebellion.steps.map((step, i) => (
                <li class:list={['step', { active: i === 0 }]} data-era={step.era} data-title={step.title}>
                  <p class="ov" lang="en">{step.era}</p>
                  <h3 class="h3">{step.title}</h3>
                  <p set:html={lx(step.text)} />
                  <span class:list={['status', step.tone]}>
                    <i />
                    {step.status}
                  </span>
                </li>
              ))
            }
          </ol>
          <figure class="stage-map" aria-label={s.rebellion.mapLabel}>
            <figcaption class="map-cap">
              <span class="t"
                ><span class="ov" id="capEra" lang="en">{s.rebellion.steps[0].era}</span><span id="capTitle">{s.rebellion.steps[0].title}</span></span
              >
              <span class="dots" aria-hidden="true">{s.rebellion.steps.map((_, i) => <i class:list={{ on: i === 0 }} />)}</span>
            </figcaption>
            <Fragment set:html={art(UNDEAD_ART.ek)} />
          </figure>
        </div>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.rebellion.note)} /></aside>
      </div>
    </section>

    <div class="wrap sep" aria-hidden="true"><svg viewBox="-16 -16 32 32"><path d={ic.sep} /></svg></div>

    <!-- V · today -->
    <section class="chap chap-bg" id="today" aria-labelledby="h-today">
      <div class="chap-art top pano" aria-hidden="true"><img src={img('deathknell.webp')} alt="" width="1280" height="540" loading="lazy" /></div>
      <div class="wrap">
        <header class="ch-head rv">
          <div class="ch-num" aria-hidden="true">V</div>
          <div><p class="ov">{u.chapter} V · {s.chapters.today}</p><h2 class="h2" id="h-today">{s.today.title}</h2></div>
        </header>
        <div class="prose rv">{s.today.intro.map((p) => <p set:html={lx(p)} />)}</div>
        <div class="sub rv"><p class="ov">{s.today.leadersLabel}</p><p class="council-text">{s.today.leadersText}</p></div>
        <div class="clans">
          {
            s.today.leaders.map((leader, i) => (
              <article class="card clan rv" style={`--clan:${leaderColor[i]};${delay(i)}`}>
                <div class="ic">
                  <svg viewBox="0 0 48 48" aria-hidden="true" set:html={leaderIcons[i]} />
                </div>
                <p class="ov">{leader.role}</p>
                <h3 class="h3">{leader.name}</h3>
                <p set:html={lx(leader.text)} />
              </article>
            ))
          }
        </div>

        <div class="sub rv"><p class="ov">{s.today.landLabel}</p><h3 class="h3">{s.today.landTitle}</h3></div>
        <div class="split top">
          <div class="prose rv">{s.today.landText.map((p) => <p set:html={lx(p)} />)}</div>
          <figure class="map-fig rv" id="tirisfal" data-p=".72,.22" data-routes>
            <Fragment set:html={art(UNDEAD_ART.tirisfal)} />
            <figcaption>
              <span>{s.today.landCaption}</span>
              <span class="keys">
                <span class="key"><i></i>{s.today.pathKey}</span>
                <span class="key rage"><i></i>{s.today.scarletKey}</span>
              </span>
            </figcaption>
            <ol class="legend" style="--cols:2">
              {
                s.today.landLegend.map((item, i) => (
                  <li>
                    <span class="lk">{i + 1}</span>
                    <span>
                      <b>{item.name}</b>
                      <Fragment set:html={lx(item.text)} />
                    </span>
                  </li>
                ))
              }
            </ol>
          </figure>
        </div>
      </div>
    </section>

    <section class="chap tight" aria-labelledby="h-beyond">
      <div class="wrap">
        <div class="sub rv"><p class="ov">{s.today.beyondLabel}</p><h3 class="h3" id="h-beyond">{s.today.beyondTitle}</h3></div>
        <div class="prose rv">{s.today.beyondText.map((p) => <p set:html={lx(p)} />)}</div>
        <figure class="map-fig rv" id="world" data-p=".72,.22" data-routes>
          <Fragment set:html={art(UNDEAD_ART.world)} />
          <figcaption>
            <span>{s.today.mapCaption}</span>
            <span class="keys"><span class="key"><i></i>{s.today.routesKey}</span></span>
          </figcaption>
          <ol class="legend">
            {
              s.today.legend.map((item, i) => (
                <li>
                  <span class="lk">{i + 1}</span>
                  <span>
                    <b>{item.name}</b>
                    <Fragment set:html={lx(item.text)} />
                  </span>
                </li>
              ))
            }
          </ol>
        </figure>
        <aside class="note rv"><p class="ov">{u.whyItMatters}</p><p set:html={lx(s.today.note)} /></aside>
      </div>
    </section>

    <StoryEnd lang={lang} title={s.outro.title} text={s.outro.text} next="Tauren" nextText={s.outro.nextText} images={s.images} />
  </div>
  <script slot="after" type="application/json" id="wf-glossary" is:inline set:html={islandJson(tips)} />
</BaseLayout>

<script>
  import '../../../scripts/story';
</script>
