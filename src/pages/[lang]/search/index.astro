---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGS, type Lang } from '../../../config';
import { ui } from '../../../i18n';
import { withBase } from '../../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/search/`)])) as Record<Lang, string>;
const config = { index: withBase(`/${lang}/search.json`), level: t.level, noResults: t.noResults, loading: t.loading };
---

<BaseLayout title={t.searchTitle} description={t.searchHint} lang={lang} alternates={alternates}>
  <h1>{t.searchTitle}</h1>
  <form class="search-form" role="search" data-search-form>
    <input
      type="search"
      name="q"
      placeholder={t.searchHint}
      aria-label={t.searchHint}
      autocomplete="off"
      spellcheck="false"
      autofocus
      data-search-input
    />
  </form>
  <p class="empty-note" data-search-status hidden></p>
  <ul class="codex-list" data-search-results></ul>
  <script type="application/json" id="wf-search-config" is:inline set:html={JSON.stringify(config)} />
</BaseLayout>

<script>
  import { searchEntries, type Searchable } from '../../../lib/search';
  import type { LoreSearchEntry } from '../../../lib/stories/lore';
  import type { TipEntry, TipPayload } from '../../../lib/tooltip-render';

  // Client-side glossary search with the app's ranking. The index is the
  // tooltip payload for every entry, so results get the same tooltips. The
  // stories' lore cards are searched too, under their name and every alias.
  type SearchIndex = TipPayload & { lore?: LoreSearchEntry[] };
  type Item = Searchable & { tip: string };
  const config = JSON.parse(document.getElementById('wf-search-config')!.textContent!) as {
    index: string;
    level: string;
    noResults: string;
    loading: string;
  };
  const input = document.querySelector<HTMLInputElement>('[data-search-input]')!;
  const results = document.querySelector<HTMLElement>('[data-search-results]')!;
  const status = document.querySelector<HTMLElement>('[data-search-status]')!;
  let payload: Promise<SearchIndex> | null = null;
  let items: Item[] = [];

  const esc = (v: unknown) =>
    String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function load(): Promise<SearchIndex> {
    payload ??= fetch(config.index)
      .then((r) => r.json() as Promise<SearchIndex>)
      .then((data) => {
        items = Object.values(data.entries).map((e) => ({ name: e.name, desc: e.desc, status: e.status, tip: e.id }));
        for (const l of data.lore ?? []) {
          const card = data.cards?.[l.id];
          if (!card) continue;
          const desc = [card.sub, ...card.lines].join(' ');
          for (const name of l.names) items.push({ name, desc, status: 'unchanged', tip: l.id });
        }
        // the shared tooltip script reads #wf-glossary
        const island = document.createElement('script');
        island.type = 'application/json';
        island.id = 'wf-glossary';
        island.textContent = JSON.stringify(data);
        document.body.append(island);
        return data;
      });
    return payload;
  }

  function row(e: TipEntry, iconBase: string): string {
    const icon = e.icon
      ? `<img class="g-icon" src="${esc(iconBase + e.icon)}.jpg" alt="" width="36" height="36" loading="lazy" />`
      : '<span class="g-icon"></span>';
    const dot = e.status !== 'unchanged' ? `<i class="g-dot g-dot--${esc(e.status)}" aria-hidden="true"></i>` : '';
    const level = e.learnedAt != null ? `<span class="g-level">${esc(config.level.replace('{n}', String(e.learnedAt)))}</span>` : '';
    return `<li class="g-row"><span class="g-tip wf-tip wf-tip--${esc(e.kind)}" data-tip="${esc(e.id)}" tabindex="0">${icon}<span class="g-text"><span class="g-name">${esc(e.name)}${dot}</span><span class="g-desc">${esc(e.desc)}</span></span>${level}</span></li>`;
  }

  // a lore card: its tooltip, plus links to the stories that tell it
  function loreRow(l: LoreSearchEntry, data: SearchIndex): string {
    const c = data.cards![l.id];
    const icon = c.icon
      ? `<img class="g-icon" src="${esc(data.iconBase + c.icon)}.jpg" alt="" width="36" height="36" loading="lazy" />`
      : '<span class="g-icon"></span>';
    const stories = l.stories.map((s) => `<a href="${esc(s.url)}">${esc(s.name)}</a>`).join('');
    return `<li class="g-row g-row--lore"><span class="g-tip wf-tip wf-tip--lore" data-tip="${esc(l.id)}" tabindex="0">${icon}<span class="g-text"><span class="g-name">${esc(c.name)}</span><span class="g-desc">${esc(c.sub)}</span></span></span><span class="g-stories">${stories}</span></li>`;
  }

  let seq = 0;
  async function run() {
    const q = input.value;
    const url = new URL(location.href);
    if (q.trim()) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    const mine = ++seq;
    if (q.trim().length < 2) {
      results.innerHTML = '';
      status.hidden = true;
      return;
    }
    if (!payload) {
      status.textContent = config.loading;
      status.hidden = false;
    }
    const data = await load();
    if (mine !== seq) return;
    // a lore card can match under several names: keep its best one
    const seen = new Set<string>();
    const hits = searchEntries(q, items, Infinity)
      .filter((h) => !seen.has(h.entry.tip) && seen.add(h.entry.tip))
      .slice(0, 50);
    const lore = new Map((data.lore ?? []).map((l) => [l.id, l]));
    results.innerHTML = hits
      .map(({ entry: { tip } }) => (lore.has(tip) ? loreRow(lore.get(tip)!, data) : row(data.entries[tip], data.iconBase)))
      .join('');
    status.textContent = config.noResults;
    status.hidden = hits.length > 0;
  }

  input.addEventListener('input', run);
  document.querySelector('[data-search-form]')!.addEventListener('submit', (e) => e.preventDefault());
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) {
    input.value = initial;
    run();
  }
</script>

<style>
  .search-form input {
    width: 100%;
    padding: 10px 14px;
    font: inherit;
    color: var(--text);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .search-form input:focus {
    outline: none;
    border-color: var(--gold-dim);
  }
  [data-search-status] {
    margin-top: 16px;
  }
  [data-search-results] {
    margin-top: 12px;
  }
  [data-search-results] :global(.g-row--lore) {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  [data-search-results] :global(.g-row--lore .g-tip) {
    flex: 1;
    min-width: 0;
  }
  [data-search-results] :global(.g-row--lore .g-name) {
    color: var(--gold);
  }
  [data-search-results] :global(.g-stories) {
    flex: none;
    display: flex;
    gap: 10px;
    font-size: 0.82rem;
  }
</style>
