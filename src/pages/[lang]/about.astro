---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LANGS, type Lang } from '../../config';
import { ui } from '../../i18n';
import { about } from '../../i18n/about';
import { withBase } from '../../utils/url';

// /tr/about/ and /en/about/: who makes the site, its sources and how the notes are written (linked from the footer).
export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const page = about[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, withBase(`/${l}/about/`)])) as Record<Lang, string>;
---

<BaseLayout title={ui(lang).aboutTitle} description={page.description} pageType="AboutPage" lang={lang} alternates={alternates}>
  <article class="about">
    <h1>{page.title}</h1>
    <p class="lede">{page.intro}</p>
    {
      page.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
          {section.links && (
            <ul>
              {section.links.map((l) => (
                <li>
                  <a href={l.href} rel="noopener">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </article>
</BaseLayout>

<style>
  .about {
    max-width: 720px;
  }
  .lede {
    font-size: 1.05rem;
    color: var(--text-dim);
  }
  .about ul {
    padding-left: 1.2em;
  }
</style>
