---
// Home: a dashboard of everything on the site, the same as the app's Home
// (ui/home/HomeScreen.kt): search, the latest patch note, the character
// creator, then a tile per feature with a live count. The race and class
// combination screen lives at /<lang>/creator/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LANGS, type Lang } from '../../config';
import glossaryData from '../../data/glossary.json';
import legacyData from '../../data/legacy.json';
import { fill, formatDate, ui } from '../../i18n';
import { getPosts } from '../../lib/blog';
import { classList, races } from '../../lib/codex';
import { professionsFile } from '../../lib/professions';
import { creatorUrl, langHome, postUrl, withBase } from '../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const alternates = Object.fromEntries(LANGS.map((l) => [l, langHome(l)])) as Record<Lang, string>;
const posts = await getPosts(lang);
const latest = posts[0];
const href = (path: string) => withBase(`/${lang}/${path}/`);

// Material icons (Apache 2.0), the same ones the app uses for these features.
const ICONS = {
  search:
    'M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z',
  star: 'M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z',
  list: 'M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z',
  face: 'M9 11.75a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5zm6 0a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-.29.02-.58.05-.86 2.36-1.05 4.23-2.98 5.21-5.37A9.97 9.97 0 0 0 17.42 10c.78 0 1.53-.09 2.25-.26.21.71.33 1.47.33 2.26 0 4.41-3.59 8-8 8z',
  person: 'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z',
  build:
    'M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z',
  account:
    'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2a7.2 7.2 0 0 1-6-3.22c.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08a7.2 7.2 0 0 1-6 3.22z',
} as const;

const features: { icon: keyof typeof ICONS; title: string; hint: string; stat?: string; href: string; builds?: boolean }[] = [
  { icon: 'star', title: t.navTalents, hint: t.tileTalents, href: href('talents'), builds: true },
  { icon: 'list', title: t.navNotes, hint: t.tileNotes, stat: posts.length ? fill(t.notesN, { n: posts.length }) : undefined, href: href('notes') },
  { icon: 'face', title: t.navRaces, hint: t.tileRaces, stat: fill(t.racesN, { n: races.length }), href: href('races') },
  { icon: 'person', title: t.navClasses, hint: t.tileClasses, stat: fill(t.classesN, { n: classList.length }), href: href('classes') },
  {
    icon: 'build',
    title: t.navProfessions,
    hint: t.tileProfessions,
    stat: fill(t.professionsN, { n: professionsFile.professions.length }),
    href: href('professions'),
  },
  { icon: 'account', title: t.navLegacy, hint: t.tileLegacy, stat: fill(t.perksN, { n: legacyData.perks.length }), href: href('legacy') },
];
const dataLine = [glossaryData.build && `${t.dataTitle} ${glossaryData.build}`, formatDate(new Date(), lang)].filter(Boolean).join(' · ');
---

<BaseLayout lang={lang} alternates={alternates}>
  <script is:inline define:vars={{ creator: creatorUrl(lang) }}>
    // the race/class screen used to be the home page: keep its old links working
    if (/(^#|&)(race|class)=/.test(location.hash)) location.replace(creator + location.hash);
  </script>

  <div class="dash">
    <h1 class="visually-hidden">Forever Campfire: Codex</h1>

    <form class="dash-search" action={href('search')} method="get" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS.search} /></svg>
      <label class="visually-hidden" for="dash-q">{t.navSearch}</label>
      <input id="dash-q" name="q" type="search" placeholder={t.searchHint} autocomplete="off" enterkeyhint="search" />
    </form>

    <div class="dash-top">
      {
        latest && (
          <a class="note-card" href={postUrl(lang, latest.slug)}>
            <span class="note-card-head">
              <span class="eyebrow">{t.latestNote}</span>
              {latest.data.build && (
                <span class="chip chip--gold">
                  {t.build} {latest.data.build}
                </span>
              )}
            </span>
            <span class="note-card-title">{latest.data.title}</span>
            {latest.data.excerpt && <span class="note-card-excerpt">{latest.data.excerpt}</span>}
            <span class="note-card-foot">
              <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date, lang)}</time>
              <span class="go">{t.readNote} →</span>
            </span>
          </a>
        )
      }

      <a class="creator-tile" href={creatorUrl(lang)}>
        <span class="creator-bg" aria-hidden="true"></span>
        <span class="creator-grain" aria-hidden="true"></span>
        <span class="creator-text">
          <span class="creator-label">Alliance · Horde</span>
          <span class="creator-title">{t.creatorTitle}</span>
          <span class="creator-row">
            <span class="creator-hint">{t.creatorHint}</span>
            <span class="go">{t.creatorStart} →</span>
          </span>
        </span>
      </a>
    </div>

    <h2 class="codex-section">{t.explore}</h2>
    <ul class="feature-grid">
      {
        features.map((f) => (
          <li>
            <a class="feature-tile" href={f.href}>
              <span class="feature-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={ICONS[f.icon]} />
                </svg>
              </span>
              <span class="feature-title">{f.title}</span>
              <span class="feature-hint">{f.hint}</span>
              {f.builds ? (
                <span class="feature-stat" data-builds-stat data-tpl={t.buildsN} hidden />
              ) : (
                f.stat && <span class="feature-stat">{f.stat}</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="dash-data">{dataLine}</p>
  </div>

  <script>
    // Saved talent builds live in this browser only (localStorage), so their
    // count is filled in here; the tile shows no number when there are none.
    import { browserStore, loadBuilds } from '../../lib/saved-builds';

    const stat = document.querySelector<HTMLElement>('[data-builds-stat]');
    const n = loadBuilds(browserStore()).length;
    if (stat && n > 0) {
      stat.textContent = (stat.dataset.tpl ?? '').replace('{n}', String(n));
      stat.hidden = false;
    }
  </script>
</BaseLayout>
