---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LANGS, type Lang } from '../../config';
import { fill, ui } from '../../i18n';
import { canPlay, classList, classSummary, classesOf, racesByFaction, racialsOf, races } from '../../lib/codex';
import { islandJson, tooltipPayload, treeTipId } from '../../lib/tooltip-payload';
import { langHome, withBase } from '../../utils/url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui(lang);
const alternates = Object.fromEntries(LANGS.map((l) => [l, langHome(l)])) as Record<Lang, string>;
const icon = (name?: string) => (name ? withBase(`/icons/${name}.jpg`) : undefined);

const factions = racesByFaction();
const defaultRace = races.find((r) => r.faction === 'Alliance') ?? races[0];
const summaries = new Map(classList.map((c) => [c.id, classSummary(c)]));
const racialsByRace = new Map(races.map((r) => [r.id, racialsOf(r)]));
const factionNumbers = (faction: string) => {
  const list = races.filter((r) => r.faction === faction);
  const racials = list.flatMap((r) => racialsByRace.get(r.id) ?? []);
  return { races: list.length, racials: racials.length, fresh: racials.filter((e) => e.status !== 'unchanged').length };
};
const tips = tooltipPayload(
  [
    ...[...racialsByRace.values()].flat().map((e) => e.id),
    ...[...summaries.values()].flatMap((s) => s.newSpells.map((e) => e.id)),
  ],
  lang,
  classList,
);
const desc = (e: { desc: string; descTr?: string }) => (lang === 'tr' && e.descTr ? e.descTr : e.desc);
---

<BaseLayout lang={lang} alternates={alternates} full>
  <section
    class="combo"
    data-combo
    data-default-race={defaultRace.id}
    data-faction={defaultRace.faction.toLowerCase()}
    style={`--bg-alliance: url(${withBase('/img/bg-alliance.svg')}); --bg-horde: url(${withBase('/img/bg-horde.svg')})`}
    data-unavailable-text={t.classUnavailable}
    data-playable-tpl={t.comboPlayable}
    aria-label={t.comboTitle}
  >
    <h1 class="visually-hidden">{t.comboTitle}</h1>

    <div class="combo-banners">
      {
        factions.map(([faction, list]) => (
          <div class={`banner banner--${faction.toLowerCase()}`}>
            <div class="banner-head">
              <svg class="crest" viewBox="0 0 32 32" aria-hidden="true">
                {faction === 'Horde' ? (
                  <path d="M16 2 L19 11 L29 8 L23 16 L29 24 L19 21 L16 30 L13 21 L3 24 L9 16 L3 8 L13 11 Z" />
                ) : (
                  <path d="M16 2 L28 7 V16 C28 23 22 28 16 30 C10 28 4 23 4 16 V7 Z" />
                )}
              </svg>
              <span class="banner-name">{faction}</span>
            </div>
            <ul class="race-list">
              {list.map((race) => (
                <li>
                  <button
                    type="button"
                    class="race-btn"
                    data-race={race.id}
                    data-faction={faction.toLowerCase()}
                    data-race-name={race.name}
                    data-classes={classesOf(race).map((c) => c.id).join(',')}
                    aria-pressed="false"
                    title={race.name}
                  >
                    {race.icon ? (
                      <img src={icon(race.icon)} alt="" width="56" height="56" loading="lazy" />
                    ) : (
                      <span class="race-fallback" aria-hidden="true">
                        {race.name.charAt(0)}
                      </span>
                    )}
                    <span class="visually-hidden">{race.name}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="combo-main">
      <div class="class-bar" role="group" aria-label={t.comboClasses}>
        {
          classList.map((cls) => (
            <button
              type="button"
              class="class-btn"
              data-class={cls.id}
              data-class-name={cls.name}
              aria-pressed="false"
              style={`--class-color: var(--class-${cls.id})`}
            >
              <img src={icon(cls.icon)} alt="" width="56" height="56" loading="lazy" />
              <span>{cls.name}</span>
            </button>
          ))
        }
      </div>
      <div class="combo-info">
        <div class="info-slot">
      {
        races.map((race) => (
          <section class="panel panel--race" data-race-panel={race.id} hidden>
            <h2>{race.name}</h2>
            <p class="panel-sub">{t.racialTraits}</p>
            <ul class="trait-list">
              {(racialsByRace.get(race.id) ?? []).map((e) => (
                <li>
                  <span class="trait wf-tip wf-tip--racial" data-tip={e.id} tabindex="0">
                    {e.icon ? <img src={icon(e.icon)} alt="" width="40" height="40" loading="lazy" /> : <span class="trait-blank" />}
                    <span class="trait-text">
                      <b>{e.name}</b>
                      {e.status !== 'unchanged' && <i class={`g-dot g-dot--${e.status}`} aria-hidden="true" />}
                      <span>{desc(e)}</span>
                    </span>
                  </span>
                </li>
              ))}
            </ul>
            <p class="panel-sub">{t.playableClasses}</p>
            <ul class="mini-icons">
              {classesOf(race).map((c) => (
                <li>
                  <img src={icon(c.icon)} alt={c.name} title={c.name} width="28" height="28" loading="lazy" />
                </li>
              ))}
            </ul>
            <a class="panel-link" href={withBase(`/${lang}/races/${race.id}/`)}>
              {t.raceDetails}
            </a>
          </section>
        ))
      }
        </div>
        <div class="info-slot">
      {
        classList.map((cls) => {
          const s = summaries.get(cls.id)!;
          return (
            <section class="panel panel--class" data-class-panel={cls.id} hidden>
              <h2 style={`color: var(--class-${cls.id})`}>{cls.name}</h2>
              <ul class="panel-facts">
                <li>{fill(t.spellCount, { n: s.spells })}</li>
                <li>{fill(t.talentCount, { n: s.talents })}</li>
                <li>{fill(t.newCount, { n: s.newSpells.length })}</li>
                <li>{fill(t.changedCount, { n: s.changedSpells })}</li>
              </ul>
              <p class="panel-sub">{t.classTrees}</p>
              <ul class="tree-list">
                {s.trees.map((tree) => (
                  <li class="wf-tip" data-tip={treeTipId(cls, tree.name)} tabindex="0">
                    {tree.icon && <img src={icon(tree.icon)} alt="" width="32" height="32" loading="lazy" />}
                    <span>{tree.name}</span>
                    <small>{fill(t.talentsInTree, { n: tree.talents })}</small>
                  </li>
                ))}
              </ul>
              {s.newSpells.length > 0 && (
                <>
                  <p class="panel-sub">{t.classNewSpells}</p>
                  <ul class="mini-icons">
                    {s.newSpells.slice(0, 12).map((e) => (
                      <li>
                        <span class="wf-tip wf-tip--spell" data-tip={e.id} tabindex="0">
                          {e.icon ? <img src={icon(e.icon)} alt={e.name} width="32" height="32" loading="lazy" /> : e.name}
                        </span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
              <p class="panel-links">
                <a class="panel-link" data-class-link href={withBase(`/${lang}/classes/${cls.id}/`)}>
                  {t.classDetails}
                </a>
                <a class="panel-link" href={withBase(`/${lang}/talents/${cls.id}/`)}>
                  {t.openPlanner}
                </a>
              </p>
            </section>
          );
        })
      }
        </div>
      </div>
    </div>

    <div class="combo-side">
      <div class="side-faction">
      {
        factions.map(([faction]) => {
          const n = factionNumbers(faction);
          return (
            <section class={`panel panel--faction panel--${faction.toLowerCase()}`} data-faction-panel={faction.toLowerCase()} hidden>
              <h2>{faction}</h2>
              <ul class="panel-facts">
                <li>{fill(t.comboFactionCount, { n: n.races })}</li>
                <li>{fill(t.comboFactionRacials, { n: n.racials })}</li>
                <li>{fill(t.comboFactionNew, { n: n.fresh })}</li>
              </ul>
            </section>
          );
        })
      }
      </div>
      <div class="combo-stage">
      <div class="stage-art" aria-hidden="true">
        <div class="stage-glow"></div>
        <div class="stage-moon"></div>
        <div class="stage-ground"></div>
      </div>
      <div class="stage-sigil">
        <div class="sigil-ring">
          <img class="sigil-race" data-stage-race-icon alt="" width="128" height="128" />
          <img class="sigil-class" data-stage-class-icon alt="" width="64" height="64" />
        </div>
        <p class="stage-faction" data-stage-faction></p>
        <p class="stage-title"><span data-stage-race></span> <span data-stage-class></span></p>
        <p class="stage-sub" data-stage-sub></p>
      </div>
      </div>
      <a class="customize-btn" data-planner-link href={withBase(`/${lang}/talents/`)}>
        {t.comboCustomize} <span aria-hidden="true">›</span>
      </a>
    </div>
  </section>

  <script slot="after" type="application/json" id="wf-glossary" is:inline set:html={islandJson(tips)} />
  <script>
    import '../../scripts/combo';
  </script>
</BaseLayout>
