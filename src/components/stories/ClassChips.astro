---
// Class strip in a story hero: the current class, links to written stories, the rest "coming soon".
import type { Lang } from '../../config';
import { STORY_UI } from '../../i18n/stories';
import { STORY_CLASSES } from '../../lib/stories/classes';
import { storyUrl } from '../../lib/stories/urls';

interface Props {
  lang: Lang;
  current: string;
}
const { lang, current } = Astro.props;
const u = STORY_UI[lang];
const label = lang === 'tr' ? 'Sınıflar' : 'Classes';
---

<div class="races class-strip" role="list" aria-label={label}>
  <span class="ov">{label}</span>
  {
    STORY_CLASSES.map((c) => {
      const isSel = c.slug === current;
      if (isSel)
        return (
          <span class:list={['chip', 'sel', `class-${c.id}`]} role="listitem" aria-current="page" style={`--dot-color: ${c.color}`}>
            <i style={`background: ${c.color}`} />
            {c.name}
          </span>
        );
      if (c.slug)
        return (
          <a class:list={['chip', `class-${c.id}`]} role="listitem" href={storyUrl(lang, c.slug!)} style={`--dot-color: ${c.color}`}>
            <i style={`background: ${c.color}`} />
            {c.name}
          </a>
        );
      return (
        <span class:list={['chip', 'off', `class-${c.id}`]} role="listitem" title={u.soon} style={`--dot-color: ${c.color}`}>
          <i style={`background: ${c.color}`} />
          {c.name}
        </span>
      );
    })
  }
</div>

<style is:global>
  /* Moving between class stories with the chips: the cover cross-fades and settles from a slight zoom while the
     chip strip stays put (cross-document view transitions; only pages with this strip opt in). Browsers without
     support simply load the next page. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
    .lore .hero-bg {
      view-transition-name: class-cover;
    }
    .lore .class-strip {
      view-transition-name: class-strip;
    }
    ::view-transition-group(class-cover) {
      animation-duration: 0.9s;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    ::view-transition-old(class-cover) {
      animation: class-cover-out 0.9s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    ::view-transition-new(class-cover) {
      animation: class-cover-in 0.9s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 0.35s;
    }
    @keyframes class-cover-out {
      to {
        opacity: 0;
        transform: scale(1.04);
        filter: blur(4px);
      }
    }
    @keyframes class-cover-in {
      from {
        opacity: 0;
        transform: scale(1.08);
        filter: blur(6px);
      }
    }
  }
</style>
