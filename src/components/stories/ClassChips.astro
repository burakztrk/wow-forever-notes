---
// Class strip in a story hero: the current class, links to written stories, the rest "coming soon".
import type { Lang } from '../../config';
import { STORY_UI } from '../../i18n/stories';
import { STORY_CLASSES } from '../../lib/stories/classes';
import { storyUrl } from '../../lib/stories/urls';

interface Props {
  lang: Lang;
  current: string;
}
const { lang, current } = Astro.props;
const u = STORY_UI[lang];
const label = lang === 'tr' ? 'Sınıflar' : 'Classes';
---

<div class="races class-strip" role="list" aria-label={label}>
  <span class="ov">{label}</span>
  {
    STORY_CLASSES.map((c) => {
      const isSel = c.slug === current;
      if (isSel)
        return (
          <span class:list={['chip', 'sel', `class-${c.id}`]} role="listitem" aria-current="page" style={`--dot-color: ${c.color}`}>
            <i style={`background: ${c.color}`} />
            {c.name}
          </span>
        );
      if (c.slug)
        return (
          <a class:list={['chip', `class-${c.id}`]} role="listitem" href={storyUrl(lang, c.slug!)} style={`--dot-color: ${c.color}`}>
            <i style={`background: ${c.color}`} />
            {c.name}
          </a>
        );
      return (
        <span class:list={['chip', 'off', `class-${c.id}`]} role="listitem" title={u.soon} style={`--dot-color: ${c.color}`}>
          <i style={`background: ${c.color}`} />
          {c.name}
        </span>
      );
    })
  }
</div>

<style is:global>
  /* Moving between class stories with the chips (cross-document view transitions; only pages with this strip opt in,
     browsers without support simply load the next page):
     - the hero (cover, shade, link cards) is one picture clipped to its own box: the new cover wipes in from the right
       while the old one drifts left;
     - the title block slides out to the right and the new one slides in from the right;
     - the chip strip and the rest of the page switch without a fade, so nothing seems to blink. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
    .lore .hero {
      view-transition-name: class-hero;
    }
    .lore .hero-copy {
      view-transition-name: class-copy;
    }
    .lore .class-strip {
      view-transition-name: class-strip;
    }
    ::view-transition-old(root),
    ::view-transition-new(root),
    ::view-transition-old(class-strip),
    ::view-transition-new(class-strip) {
      animation: none;
    }
    ::view-transition-group(class-hero),
    ::view-transition-group(class-copy) {
      overflow: clip;
      animation-duration: 0.9s;
    }
    ::view-transition-old(class-hero) {
      animation: class-hero-out 0.9s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    ::view-transition-new(class-hero) {
      animation: class-hero-in 0.9s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    ::view-transition-old(class-copy) {
      animation: class-copy-out 0.4s cubic-bezier(0.4, 0, 1, 1) both;
    }
    ::view-transition-new(class-copy) {
      animation: class-copy-in 0.55s cubic-bezier(0, 0, 0.2, 1) 0.35s both;
    }
    @keyframes class-hero-out {
      to {
        transform: translateX(-12%);
        filter: brightness(0.6);
      }
    }
    @keyframes class-hero-in {
      from {
        clip-path: inset(0 0 0 100%);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
    @keyframes class-copy-out {
      to {
        opacity: 0;
        transform: translateX(90px);
      }
    }
    @keyframes class-copy-in {
      from {
        opacity: 0;
        transform: translateX(90px);
      }
    }
  }
</style>
