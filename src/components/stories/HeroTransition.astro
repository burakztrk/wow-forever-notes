---
// The animation between two story pages of the same kind reached through the chip strip (class stories and race
// stories share it): see the comment in the style block. Render it once per page next to the strip.
---

<style is:global>
  /* Moving between class (or race) stories with the chips (cross-document view transitions; only pages with this strip opt in,
     browsers without support simply load the next page):
     - the hero (cover, shade, link cards) is one picture clipped to its own box: the new cover wipes in from the right
       while the old one drifts left;
     - the title block slides out to the right and the new one slides in from the right;
     - the chip strip and the rest of the page switch without a fade, so nothing seems to blink. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
    .lore .hero {
      view-transition-name: story-hero;
    }
    .lore .hero-copy {
      view-transition-name: story-copy;
    }
    .lore .hero-in > .races {
      view-transition-name: story-strip;
    }
    ::view-transition-old(root),
    ::view-transition-new(root),
    ::view-transition-old(story-strip),
    ::view-transition-new(story-strip) {
      animation: none;
    }
    ::view-transition-group(story-hero),
    ::view-transition-group(story-copy) {
      overflow: clip;
      animation-duration: 0.9s;
    }
    ::view-transition-old(story-hero) {
      animation: story-hero-out 0.9s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    ::view-transition-new(story-hero) {
      animation: story-hero-in 0.9s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    ::view-transition-old(story-copy) {
      animation: story-copy-out 0.4s cubic-bezier(0.4, 0, 1, 1) both;
    }
    ::view-transition-new(story-copy) {
      animation: story-copy-in 0.55s cubic-bezier(0, 0, 0.2, 1) 0.35s both;
    }
    @keyframes story-hero-out {
      to {
        transform: translateX(-12%);
        filter: brightness(0.6);
      }
    }
    @keyframes story-hero-in {
      from {
        clip-path: inset(0 0 0 100%);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
    @keyframes story-copy-out {
      to {
        opacity: 0;
        transform: translateX(90px);
      }
    }
    @keyframes story-copy-in {
      from {
        opacity: 0;
        transform: translateX(90px);
      }
    }
  }
</style>

<script is:inline>
  // A transition only looks right when the new hero is ready: over a real network the new cover image used to arrive
  // in the middle of the wipe and pop in. So (1) every story page preloads its cover as a render-blocking <link>
  // (BaseLayout `heroImage`), so the first frame already has it, (2) the page and cover of a chip are fetched as soon
  // as the pointer, a finger or the keyboard reaches it, and (3) if the new page still has no cover at its first
  // frame, the animation is skipped and the page just shows.
  (function () {
    var warmed = {};
    function warm(a) {
      if (!a || warmed[a.href]) return;
      warmed[a.href] = 1;
      var l = document.createElement('link');
      l.rel = 'prefetch';
      l.href = a.href;
      document.head.appendChild(l);
      if (a.dataset.cover) new Image().src = a.dataset.cover;
    }
    function onStrip(e) {
      var a = e.target.closest && e.target.closest('.hero-in > .races a');
      if (a) warm(a);
    }
    ['pointerover', 'touchstart', 'focusin'].forEach(function (t) {
      document.addEventListener(t, onStrip, { passive: true });
    });
    addEventListener('pagereveal', function (e) {
      if (!e.viewTransition) return;
      // the render-blocking preload has finished once the page is allowed to render; the <img> itself may not have
      // been parsed yet at this point, so look at the resource, not only at the element
      var pre = document.querySelector('link[rel="preload"][as="image"][blocking]');
      var img = document.querySelector('.lore .hero-bg img');
      var loaded = !!(pre && performance.getEntriesByName(pre.href).length) || !!(img && img.complete && img.naturalWidth);
      if (!loaded) e.viewTransition.skipTransition();
    });
  })();
</script>
