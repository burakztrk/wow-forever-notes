---
// Race strip in a story hero: the current race, links to written stories, the rest "coming soon".
import type { Lang } from '../../config';
import { STORY_UI } from '../../i18n/stories';
import { STORY_RACES } from '../../lib/stories/races';
import { storyUrl } from '../../lib/stories/urls';
import { withBase } from '../../utils/url';

interface Props {
  lang: Lang;
  current: string;
}
const { lang, current } = Astro.props;
const u = STORY_UI[lang];
---

<div class="races" role="list" aria-label={u.races}>
  <span class="ov">{u.races}</span>
  {
    STORY_RACES.map((race) => {
      const h = race.faction === 'h';
      const both = race.faction === 'ah';
      if (race.slug === current)
        return (
          <span class:list={['chip', 'sel', { h, ah: both }]} role="listitem" aria-current="page">
            <i />
            {race.name}
          </span>
        );
      if (race.slug)
        return (
          <a class:list={['chip', { h, ah: both }]} role="listitem" href={storyUrl(lang, race.slug!)}>
            <i />
            {race.name}
          </a>
        );
      return (
        <span class:list={['chip', 'off', { h, ah: both }]} role="listitem" title={u.soon}>
          <i />
          {race.name}
        </span>
      );
    })
  }
</div>
