---
// Wide banner on a race page that links to the race's story (/<lang>/races/<slug>/).
import type { Lang } from '../../config';
import { ui } from '../../i18n';
import { storyRace } from '../../lib/stories/races';
import { RACE_STORIES } from '../../lib/stories/refs';
import { storyUrl } from '../../lib/stories/urls';
import { withBase } from '../../utils/url';

interface Props {
  lang: Lang;
  raceId: string;
}

const { lang, raceId } = Astro.props;
const t = ui(lang);
const entry = storyRace(raceId);
const story = entry?.slug ? RACE_STORIES[entry.slug as keyof typeof RACE_STORIES]?.[lang] : undefined;
const faction = { a: 'Alliance', h: 'Horde', ah: 'Alliance · Horde' };
---

{
  entry && story && entry.cover && (
    <a class="story-banner" href={storyUrl(lang, entry.slug!)}>
      <img class="story-banner-bg" src={withBase(entry.cover.src)} alt="" loading="lazy" style={`object-position:${entry.cover.position}`} />
      <span class="story-banner-text">
        <span class="story-banner-over">
          {t.navStories} · <span lang="en">{faction[entry.faction]}</span>
        </span>
        <span class="story-banner-name" lang="en">{entry.name}</span>
        <span class="story-banner-lead">{story.lead}</span>
        <span class="story-banner-cta">{t.storiesRead}</span>
      </span>
    </a>
  )
}
