---
// Patch notes for one class, race or profession, from the posts' sections
// (src/lib/post-sections.ts). Newest first, every note collapsed.
import type { Lang } from '../config';
import { fill, formatDayMonth, ui } from '../i18n';
import type { PatchNote } from '../lib/blog';
import { postUrl } from '../utils/url';

interface Props {
  lang: Lang;
  notes: PatchNote[];
  empty: string;
  // profession page: name each note by its section ("Mining", "General")
  nameBySection?: boolean;
  // note title; defaults to the section's own heading ("Gnome", not the data's "Gnomes")
  name?: string;
  id?: string;
}

const { lang, notes, empty, nameBySection = false, name = '', id = 'patch-notes' } = Astro.props;
const t = ui(lang);
const items = notes.flatMap(({ post, sections }) =>
  nameBySection
    ? sections.map((s) => ({ post, sections: [s], title: s.title }))
    : [{ post, sections, title: name || sections[0].title }],
);
---

<section class="patch-notes" id={id}>
  <h2 class="codex-section">{t.patchNotes}</h2>
  {items.length === 0 && <p class="empty-note">{empty}</p>}
  {
    items.map(({ post, sections, title }) => (
      <details class="patch-note">
        <summary>
          <span class="patch-note-head">
            <time datetime={post.data.date.toISOString()}>
              {fill(t.patchNotesItem, { date: formatDayMonth(post.data.date, lang), name: title })}
            </time>
            {post.data.build && <span class="patch-note-build">{post.data.build}</span>}
          </span>
        </summary>
        <div class="prose patch-note-body">
          {sections.map((s) => <Fragment set:html={s.html} />)}
        </div>
        <a class="patch-note-link" href={`${postUrl(post.lang, post.slug)}#${sections[0].anchor}`}>
          {t.fullPost}
        </a>
      </details>
    ))
  }
</section>
